# OBS-3 · OBS-4 · OBS-8 설정 소유 파일. 지금 들어 있는 것은 OBS-3 의 Micrometer 설정이다.
# management.metrics.* 밖으로 나가는 키를 추가할 때는 아래 tomcat 스위치처럼 왜 이 파일에
# 있는지를 같이 적을 것.
#
# /actuator/prometheus 는 management.yml(OBS-20) allowlist로 열려 있다.
# PrometheusExposureContractTest 가 이 파일의 백분위 설정과 allowlist를 함께 로드해
# 실제 HTTP scrape 결과를 검증한다. exposure는 여기서 재정의하지 않는다.
#
# 열리고 나면 Prometheus 가 이 미터들을 1초마다 긁어간다. 시계열 수집·보관은 Prometheus 가
# 맡고 화면은 직접 만든다(Grafana 미사용 — 같은 격차 숫자가 v1 은 N_A, v2 는 오류, v3 는
# 정상이라 임계선으로 표현할 수 없다).
#
# 1초 scrape 근거 — up 평균 1.0000 · 분당 60샘플 · scrape 평균 6.8ms(최대 45.3ms, 타임아웃
# 900ms) · 8,200 req/s 부하 중 2.5~2.7ms · 처리량 영향 0.06% · CPU 0.76% · 메모리 49MB.
#
# 출처: OBS-3 결정 시 팀이 공유한 측정 결과(2026-08). 이 저장소의 테스트가 재현하는 값이
# 아니므로 환경이 바뀌면 다시 재야 한다.
#
# ⚠️ 키는 대괄호 + 따옴표로 쓴다. 점 표기는 절반만 실패한다 — percentiles 는 바인딩되고
#    expiry 만 조용히 무시되어, 0.99 가 나오니 설정이 먹은 줄 알게 된다.
#
# 커밋되는 것은 이 .example 이고 실제로 로드되는 observation.yml 은 gitignore 대상이다.
# 계약 테스트는 이 파일을 임시 디렉터리에 observation.yml 로 복사해 실제 로딩 경로를 태운다.
management:
  metrics:
    distribution:
      percentiles:
        # 없으면 백분위가 아예 나오지 않는다.
        #
        # Prometheus 는 quantile 라벨로 내보낸다: http_server_requests_seconds{...,quantile="0.99"}
        # _bucket 시계열은 0개다 — histogram_quantile 로 병합할 수 없고 이 값은 인스턴스별
        # 값이다. 병합하려면 percentiles-histogram 이 필요한데, 인스턴스 최댓값을 쓰기로
        # 확정했으므로 바꾸지 않는다(병합값은 한 인스턴스만 느려진 상황을 희석해 숨긴다).
        "[http.server.requests]": 0.5, 0.95, 0.99
        # OBS-4 집계 Timer. 키가 미터 '이름' 이므로 태그 조합마다 등록된 Timer 전부에 걸린다
        # — URI 그룹 5종 × outcome 4종(OBS-31: success · policy_reject · client_invalid ·
        # system_failure)이 모두 같은 관측 창을 쓴다. 축을 늘려도 여기는 안 고쳐도 된다.
        "[app.http.latency]": 0.5, 0.95, 0.99
        # Redis 명령 레이턴시(CY-310). 미터를 등록하는 것은 infra:redis 의 RedisLatencyAutoConfiguration 이고
        # (api 가 runtimeOnly 로 물고 있다), 어느 창으로 볼지는 위 둘과 같은 이유로 여기가 소유한다.
        # 접두사 키 하나로 firstresponse · completion 두 미터를 함께 덮는다.
        "[lettuce.command]": 0.5, 0.95, 0.99
      expiry:
        # 기본 2분 대신 10초. 2분을 두면 부하 종료 후 2분간 화면이 '아직 부하 중'으로 읽힌다.
        # 실측 — 부하가 멈추면 정확히 expiry 시점에 p99 가 0 으로 떨어진다(buffer-length 무관).
        #
        # 대가 둘. (1) 창당 표본이 줄어 p99 가 더 튄다. (2) 무부하 구간의 p99 가 '없음'이
        # 아니라 0 으로 읽힌다 — MeterValueReader 가 0 을 빈 값으로 바꿔 돌려주는 이유다.
        #
        # ⚠️ 이 값이 백분위의 관측 창을 정한다. 1초마다 긁으면 각 값이 직전 10초를 덮어
        #    연속 표본이 90% 겹친다 — "1초 구간 p99" 로 읽으면 안 된다. 회차 간 그래프를
        #    비교하려면 이 값이 회차마다 같아야 한다.
        "[http.server.requests]": 10s
        "[app.http.latency]": 10s
        # ⚠️ 위 둘과 반드시 같은 값이어야 한다. 기본 2분을 그대로 두면 HTTP 는 10초 창,
        #    Redis 는 120초 창이 되어 같은 시점의 값이 아니게 된다. 부하를 끊은 직후 HTTP 는
        #    0 으로 떨어지는데 Redis 는 2분간 최고치를 물고 있어, "HTTP 는 정상인데 Redis 가
        #    느리다" 는 존재하지 않는 결론이 나온다. batch 의 management.yml 도 같은 값을 쥔다.
        "[lettuce.command]": 10s

# tomcat.threads.* 는 이 스위치가 켜져 있을 때만 등록된다. 끄면 미터가 0 이 되는 게 아니라
# 아예 없어지고 OBS-8 의 worker 지표가 조용히 빈다.
#
# ⚠️ Tomcat 의 Registry 는 JVM 전역이라 테스트에서 컨텍스트별로 덮어써도 격리되지 않는다.
#    "꺼도 잘 나오더라" 는 관측은 먼저 뜬 컨텍스트가 켜 놓은 오염이다.
#
# ⚠️ management.metrics.* 가 아닌 유일한 키다. 원래 자리는 application.yml 이지만 그 파일은
#    OBS-3 범위 밖이라, 이 스위치가 존재하는 이유(=미터 등록 조건)와 같은 파일에 둔다.
server:
  tomcat:
    mbeanregistry:
      enabled: true

observation:
  # ── attempt live 층화 샘플링 (OBS-15 · DEC-04) ────────────────────────────────
  #
  # ⚠️ 세 값은 전부 잠정값이다. 이 티켓이 고정한 것은 손잡이의 이름과 의미이고, 수치는
  #    부하 배포 전에 실측으로 정한다. 값이 정해질 때 코드를 고쳐야 하면 그 회차에 코드
  #    변경과 튜닝이 섞여 어느 쪽이 결과를 바꿨는지 못 가른다.
  #
  # 왜 샘플링이 필요한가 — attempt:live 는 MAXLEN ~ 200 이다. 초당 attempt 가 3,000 건이면
  # 200 개 버퍼는 67ms 분량이고, 화면은 1 초마다 폴링한다. 샘플링이 없으면 매 폴링이 직전
  # 67ms 창만 보는데 그 창은 결과 코드에 대해 균등하지 않다 — 재고가 소진되면 거의 전부가
  # 409 라 그때 봐야 하는 5xx 한 건이 그 사이에서 사라진다.
  #
  # ⚠️ max-per-second 는 하드 상한이 아니다. 층별 최소 보장이 그것을 넘을 수 있고, 그게
  #    의도다 — 하드로 걸면 늦게 나타난 층(정확히 새로 생긴 장애)이 그 초에 한 건도 못
  #    들어간다. 실제 상한은 max(max-per-second, 활성 층 수 × min-per-stratum-per-second) 다.
  #    기동 로그가 최악값을 적고, 실제 통과량은 app_attempt_live_sampled_total 이 낸다.
  #
  # ⚠️ 인스턴스당이다. 샘플러는 인스턴스 하나에 하나이고 리스너 스레드 셋이 공유한다.
  #    api 가 4 대면 실제 Redis 쓰기는 최대 4 배다. 분산 한도를 두려면 Redis 를 한 번 더
  #    왕복해야 해서 두지 않았다 — 관측이 관측을 위해 사는 비용이 된다.
  #
  # 기본값은 AttemptSamplingProperties 의 DEFAULT_* 상수와 같아야 한다. 두 파일에 걸친
  # 계약이라 AttemptSamplingYamlContractTest 가 둘을 함께 본다.
  attempt:
    live:
      sampling:
        min-per-stratum-per-second: ${ATTEMPT_LIVE_SAMPLING_MIN_PER_STRATUM:5}
        max-per-second: ${ATTEMPT_LIVE_SAMPLING_MAX_PER_SECOND:100}
        max-strata: ${ATTEMPT_LIVE_SAMPLING_MAX_STRATA:20}

  issuance:
    # 운영에서는 컨테이너별 HOSTNAME을 주입한다. api-local은 로컬 단일 인스턴스 기본값이다.
    producer-instance-id: ${HOSTNAME:api-local}
    campaign:
      # coupon_id 라벨 예외는 최대 100개까지만 허용한다. 초과 캠페인은 축출하지 않고 거부한다.
      max-active-campaigns: ${OBSERVATION_CAMPAIGN_MAX_ACTIVE:100}
      retire-grace-period: ${OBSERVATION_CAMPAIGN_RETIRE_GRACE:30m}
      # 운영 보관 요구가 확정되기 전의 임시 기본값: 지연 재처리는 하루 동안 막고, 개수도 제한한다.
      tombstone-retention: ${OBSERVATION_CAMPAIGN_TOMBSTONE_RETENTION:1d}
      tombstone-max-entries: ${OBSERVATION_CAMPAIGN_TOMBSTONE_MAX_ENTRIES:1000}
  prometheus:
    archive:
      connect-timeout: 1s
      read-timeout: 10s

campaign:
  lifecycle:
    redis:
      # API JVM만 구독한다. Batch는 종료 이벤트 발행자이므로 기본값(false)을 유지한다.
      subscriber-enabled: ${CAMPAIGN_LIFECYCLE_REDIS_SUBSCRIBER_ENABLED:true}
