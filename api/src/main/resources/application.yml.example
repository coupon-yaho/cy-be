spring:
  application:
    name: coupon-api
  config:
    import:
      - classpath:storage.yml
      - classpath:management.yml   # CY-09

  jackson:
    default-property-inclusion: non_null

server:
  port: ${SERVER_PORT:8080}
  shutdown: graceful

admin:
  pagination:
    default-limit: ${ADMIN_PAGINATION_DEFAULT_LIMIT:50}
  analytics:
    max-range-years: ${ADMIN_ANALYTICS_MAX_RANGE_YEARS:1}

logging:
  pattern:
    console: "%d{HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{36} - %msg%n"
  level:
    com.kafkick: DEBUG
