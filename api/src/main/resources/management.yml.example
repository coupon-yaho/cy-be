management:
  health:
    redis:
      enabled: false
  server:
    port: ${MANAGEMENT_PORT:9090}
  endpoints:
    web:
      exposure:
        # admission-capacity는 후속 구현을 위한 예약값이며 현재 endpoint bean은 없다.
        include: health,metrics,prometheus,admission-capacity
        # allowlist 가 잘못 확장돼도 민감한 엔드포인트는 노출하지 않는다.
        exclude: env,configprops,beans,heapdump
  endpoint:
    health:
      # 상세에 절대경로·JDBC URL 이 실린다.
      show-details: never
      status:
        # OBSERVATION_DOWN 을 UP 보다 덜 심각하게 둔다. 합산 상태는 가장 심각한 것으로 정해지므로,
        # 이 순서 덕분에 관측 풀이 죽어도 /actuator/health 는 UP 을 유지한다 — 발급 API 가 멀쩡한데
        # 로드밸런서가 인스턴스를 빼는 일을 막는 게 목적이다.
        order: DOWN,OUT_OF_SERVICE,UP,OBSERVATION_DOWN,UNKNOWN
        # ⚠️ 여기에 http-mapping 을 쓰지 말 것. 하나라도 지정하면 기본 매핑이 병합이 아니라
        #    교체된다(SimpleHttpCodeStatusMapper). 전역에 한 줄 넣는 순간 DOWN·OUT_OF_SERVICE 의
        #    503 이 사라져서, 운영 풀이 죽어도 /actuator/health 가 200 을 돌려준다.
        #    매핑이 필요하면 아래처럼 그룹 안에서만 정의한다.
      group:
        # 관측 풀만 따로 본다 — 비밀번호 오타로 배포해도 기동·헬스가 통과하던 구멍을 여기서 막는다.
        obs:
          include: obsDb
          status:
            http-mapping:
              # 그룹으로 조회할 때는 실패로 보여야 경보를 걸 수 있다.
              OBSERVATION_DOWN: 503
              # 교체 규칙 때문에 기본값을 여기서 다시 적어 준다. 빠뜨리면 이 그룹에서만 200 이 된다.
              DOWN: 503
              OUT_OF_SERVICE: 503
