# OBS-17 소유 파일. 토픽·프로듀서·컨슈머 그룹의 설정 계층이다. 컨슈머 구현과 적재는 OBS-15 다.
#
# ⚠️ spring.kafka.* 가 아니다. 이 저장소는 Boot 의 Kafka 자동설정을 쓰지 않는다 —
#    infra:mq 는 spring-kafka 만 의존하고 spring-boot-kafka 를 의존하지 않는다.
#    자동설정은 공용 KafkaTemplate 하나와 리스너 컨테이너 팩토리 하나를 만드는데, 이 티켓의
#    전제가 프로듀서 둘을 완전히 분리하고 auto.offset.reset 을 토픽마다 반대로 두는 것이다.
#    여기에 spring.kafka.bootstrap-servers 를 적으면 아무도 읽지 않는 죽은 설정이 된다.
#
# 커밋되는 것은 이 .example 이고 실제로 로드되는 kafka.yml 은 gitignore 대상이다.
kafka:
  # 옵트인이다. 켜면 KafkaAdmin·프로듀서 두 벌·AttemptEventPublisher 가 함께 올라온다.
  #
  # 브로커가 없는 회차(v1·v2)에서 켜 두면 토픽 생성이 계속 실패한다. 앱은 그래도 뜨는데,
  # 그 이유는 fatalIfBrokerNotAvailable 이 아니라 토픽 생성이 아예 기동 경로 밖에서
  # 돌기 때문이다(KafkaTopicProvisioner — 별도 실행기에서 물러서며 계속 재시도, 실패는 삼킨다).
  # 앱은 뜨지만 재시도 로그가 쌓이므로, 브로커가 없으면 끈 채로 둔다.
  enabled: ${KAFKA_ENABLED:false}

  # 브로커 3대 전제다(RF3 · ISR2). 한 대만 띄운 로컬에서 켜면 토픽 생성이
  # INVALID_REPLICATION_FACTOR 로 실패한다 — 파티션·복제 수는 발표 회차의 값이라
  # 로컬 편의로 낮추지 않는다. 브로커가 없으면 위 스위치를 끈 채로 둔다.
  #
  # ⚠️ 값 검증은 여기가 아니라 프로듀서를 만드는 자리에서 한다. 프로퍼티에 @NotEmpty 를
  #    걸면 스위치를 끈 회차에서도 검증이 돌아, Kafka 를 쓰지도 않는 배포가 이 값 하나로
  #    기동에 실패한다.
  bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:localhost:9094}

  # 기동을 마친 뒤 별도 실행기가 토픽을 만든다. 끄면 선언만 하고 만들지 않는다.
  #
  # ⚠️ 브로커에 auto.create.topics.enable=false 를 요구한다. 켜져 있으면 프로비저닝보다
  #    첫 발급이 빠를 때 브로커가 RF1 · 파티션1 짜리 토픽을 대신 만들어 버리고, RF 는
  #    나중에 못 고친다 — 노드 하나가 빠지면 그 파티션이 사라져 영구 미영속 발급이 된다.
  #    반영 여부는 /actuator/prometheus 의 app_kafka_topics_provisioned 가 1 인지로 본다
  #    (미터 이름은 점을 쓰지만 노출 이름은 밑줄이다). 값이 비어 있으면 이유는 짝이 되는
  #    app_kafka_topics_provisioned_state 가 SourceStatusCode 로 낸다 — 프로비저닝을 끈
  #    회차는 N_A 다.
  #
  #    ⚠️ UNAVAILABLE 은 원인이 둘 겹친다. 지표로 가른다 —
  #       app_kafka_topics_provisioned_cause{cause="unconfirmed"} 1
  #           → 브로커가 아직 안 떴다. 그대로 두면 낫는다(계속 재시도한다, 간격 상한 5분)
  #       app_kafka_topics_provisioned_cause{cause="mismatched"} 1
  #           → 선언과 다른 토픽이 이미 있다. 재기동으로 안 낫는다 — 다시 만들거나 재배치해야
  #             한다(복제본 수는 만들 때만 정해진다). 이 경우에만 재시도를 즉시 멈춘다.
  #       세 값(none · unconfirmed · mismatched)은 닫혀 있어 시계열이 늘지 않는다.
  #
  # ⚠️ 확인은 "기동 직후" 한 번 성공하면 끝이다. 그 뒤에 토픽이 지워지고 브로커가 RF1 으로
  #    되살려도 이 지표는 1 을 유지한다 — 주기 재확인은 스케줄러가 필요해 이 티켓에서 뺐다.
  #    토픽을 손으로 지웠으면 앱을 재기동해서 다시 확인시킬 것.
  #
  # 반영 확인은 파티션 수 · 복제본 수 · min.insync.replicas 세 가지를 본다. ISR 하한은
  # AdminClient.describeConfigs 로 브로커에 지금 걸린 값을 읽는다 — 만들 때 2로 선언해도
  # 장애 대응 중 1로 낮춰 두면 acks=all 이 복제본 한 대에만 쓰고 성공하기 때문이다.
  # 설정은 다음 시도가 되돌릴 수 있어 불일치가 아니라 미확인(unconfirmed)으로 낸다.
  #
  # 프로비저닝은 확인될 때까지 포기하지 않는다. 5회(약 45초)째에 상태를 UNAVAILABLE 로 올려
  # 경보를 걸지만 재시도는 계속한다 — 브로커 3대 롤링 재기동 창이 그보다 길면, 유한 재시도로는
  # 그 인스턴스가 재기동 전까지 토픽 없이 트래픽을 받는다.
  #
  # 토픽 생성을 기동 경로에 두면 브로커가 없을 때 컨텍스트 하나당 약 15초가 걸린다(실측).
  # KafkaAdmin 의 operationTimeout 은 '작업 하나' 의 상한이지 전체 상한이 아니라서,
  # 어드민 생성 · 토픽 조회 · 토픽 생성이 각각 그 값을 쓴다.
  provision-topics: ${KAFKA_PROVISION_TOPICS:true}

  notification:
    relay:
      # DB claim은 30초 뒤 다른 인스턴스가 회수하고, 한 번에 한 행씩 100ms 간격으로 발행한다.
      lease: ${KAFKA_NOTIFICATION_RELAY_LEASE:30s}
      fixed-delay-ms: ${KAFKA_NOTIFICATION_RELAY_FIXED_DELAY_MS:100}

# ── 지표 개수 (실측 · 2026-08-22) ───────────────────────────────────────────────
# 프로듀서 클라이언트 메트릭은 client.id 당 74개 이름이고, 이 계층은 프로듀서를 둘
# (coupon-attempt · coupon-persist) 띄우므로 74 × 2 = 148 시계열이다. 이걸 포함한
# /actuator/prometheus 전체 응답이 32,552 바이트, scrape 1회 9.46ms 였다.
# Prometheus 쪽 타임아웃 여유(900ms)에 비해 충분히 작아 별도 스위치를 두지 않았다.
#
# ⚠️ 브로커가 없는 상태에서 잰 값이다. 브로커가 붙으면 토픽·노드별 메트릭이 더 생기므로
#    (per-topic 메트릭은 발행이 시작돼야 나온다) 그때 다시 재야 한다.
