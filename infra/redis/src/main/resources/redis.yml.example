spring:
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      connect-timeout: ${REDIS_CONNECT_TIMEOUT:1s}
      timeout: ${REDIS_COMMAND_TIMEOUT:500ms}

# Redis가 새로 비었을 때 api 기동이 한 번만 저장한다(SET NX). 현재 batch는 이 자동설정을
# 제외하므로 부트스트랩하지 않는다.
runtime-config:
  bootstrap:
    engine-version: ${RUNTIME_CONFIG_BOOTSTRAP_ENGINE_VERSION:V1}
    release-stage: ${RUNTIME_CONFIG_BOOTSTRAP_RELEASE_STAGE:V1}
    queue-mode: ${RUNTIME_CONFIG_BOOTSTRAP_QUEUE_MODE:OFF}

# 외부 게이트웨이 공유 계약은 설정으로 이름을 바꾸지 않는다.
# 외부 공유 키는 capacity:coupon-svc:v1, coupons:active, coupon:policy, stock:{couponId}다.
# API는 다중 writer 순서 제어용 내부 키 coupon-svc:queue-gateway:snapshot도 쓰며,
# 게이트웨이가 소유하는 gw:*, queue:*, admitted:*에는 쓰지 않는다.
