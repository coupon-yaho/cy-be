# api/batch 가 spring.config.import 로 가져다 쓰는 공통 DB 설정.
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # connectTimeout·socketTimeout 이 없으면 MySQL 이 응답을 멈췄을 때 커넥션이 무한 대기한다.
    # 풀 10개가 그대로 묶이면 발급 경로가 통째로 정지한다 — 관측 풀만 3초에 끊기고 정작 운영이
    # 무방비인 상태를 막는 값이다.
    #
    # ⚠️ socketTimeout 은 innodb_lock_wait_timeout(기본 50s) 보다 커야 한다. v1(비관적 락)에서
    #    락 대기는 정상 동작인데, 이 값이 더 작으면 정상 대기가 통신 오류로 끊긴다. 서버 쪽
    #    락 대기 시간을 줄이면 이 값도 같이 내린다.
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:app}?serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true&connectTimeout=${DB_CONNECT_TIMEOUT_MS:3000}&socketTimeout=${DB_SOCKET_TIMEOUT_MS:60000}
    # 로컬 개발용 기본값. 운영은 환경변수로 최소 권한 계정을 주입한다.
    username: ${DB_USERNAME:app}
    password: ${DB_PASSWORD:app}
    hikari:
      # 서버 max_connections=50 이다. 전 인스턴스 풀 합계가 이를 넘지 않게 배분한다.
      #
      # ⚠️ 이 50 은 infra/mysql/my.cnf 에 적혀 있고, 그 파일은 gitignore 대상이라 저장소가
      #    보증하지 않는다. 아래 계산의 분모는 각자 환경의 실제 값을 확인해야 한다.
      #
      # ⚠️ maximum-pool-size 는 여기 두지 않는다. 이 파일은 spring.config.import 로 들어가는데,
      #    import 로 들어온 문서가 그것을 선언한 문서보다 우선한다. 여기 적으면 각 모듈이 자기
      #    파일에 적은 값이 에러도 경고도 없이 무시된다 — batch 의 4가 실제로 그렇게 무시되고
      #    10으로 떴다. 풀 크기는 모듈마다 다른 값이므로 각 모듈이 선언한다.
      #      api   : api/application.yml   의 ${DB_POOL_SIZE:3}
      #      batch : batch/application.yml 의 ${BATCH_DB_POOL_SIZE:4}
      #    선언을 빠뜨리면 Hikari 기본값 10 으로 뜬다(조용히 늘어난다). 아래 계산을 다시 한다.
      #
      # 관측을 켠 JVM 만 obs 2 를 더 쓴다. 실측 기준 배분:
      #   api 4대  20  (main  3 + obs 2) × 4   ← 관측 켬
      #   batch     6  (main  4 + obs 2)       ← 관측 켬 (OBS-5 도메인 Gauge)
      #   합계     26 / 50
      #
      # ⚠️ 이 계산은 아직 성립하지 않는다. 롤링 배포 중에는 구/신 인스턴스가 겹쳐 뜨는데, 그때
      #    동시에 살아 있는 인스턴스 수가 미확정이라 최대 동시 커넥션의 상한을 계산할 수 없다.
      #    구/신 인스턴스가 겹치면 위 합계에 인스턴스당 5가 추가된다.
      #    풀을 줄이는 것 말고 서버 쪽 max_connections 를 올리는 선택지도 같이 검토한다 —
      #    50 은 MySQL 기본값(151)보다 낮게 잡아 둔 값이다.
      #    TODO: 배포 전략을 확정한 뒤 풀 크기를 다시 정한다. 확정 전까지 여기 숫자는
      #    근거가 없으므로 바꾸지 않는다 — 추측한 값으로 조이면 v1 측정이 오염된다.
      #
      # 인스턴스를 늘리거나 obs 풀을 키우기 전에 이 계산을 다시 한다.
      connection-timeout: 3000
      validation-timeout: 3000
      keepalive-time: 30000
      max-lifetime: 580000   # MySQL wait_timeout 보다 짧게. 끊긴 커넥션 재사용 방지

  # 트랜잭션 전체를 시간으로 묶는 손잡이. 값은 부하 측정 뒤에 정한다 — v1 은 락 대기가 정상
  # 동작이라 여기서 추측한 숫자를 넣으면 정상 발급이 죽는다. 지금은 경로만 살려 둔다.
  # transaction:
  #   default-timeout: 30s

  # [CY-488] 운영 풀의 JDBC 질의 타임아웃. 값을 두지 않기로 정했고, 그 판단의 근거를 남긴다.
  #
  # ⚠️ 이 키는 운영 '풀' 전체가 아니라 @Primary JdbcTemplate 하나에만 닿는다. 실제 주입 지점은
  #    JdbcBenchmarkRunRepository(쓰기 전이)와 JdbcRunTimeseriesArchiveStore 둘뿐이고, Flyway 와
  #    Spring Batch JobRepository 는 DataSource 를 직접 물어 이 값과 무관하다.
  #
  # 실측(2026-08-25, MySQL 8.4.11 · Connector/J 9.7.0, 유휴 DB). 이 템플릿이 실행하는 가장 무거운
  # 문장은 아카이브의 500행 청크 INSERT 이고, 10000행 3회 반복에서:
  #   FOR UPDATE 0~11ms · DELETE 1~42ms · 가장 느린 500행 청크 12~49ms
  #
  # 값을 정하려면 '부하 중' 수치가 필요한데 그것이 없다. 유휴 49ms 에 임의의 배수를 곱한 숫자는
  # 근거가 아니고, 그 숫자는 발급 경로가 합류하는 순간 사고가 된다 — 실측상 이 손잡이는 v1
  # 비관적 락의 정상 대기까지 끊는다(락 걸린 행 SELECT..FOR UPDATE 가 setQueryTimeout(1) 에서
  # 1.02초에 잘렸다). 무한 대기는 위 URL 의 socketTimeout=60000 이 이미 막고 있어, 비워 두는
  # 대가는 '60초 상한이 그대로 남는다' 뿐이다.
  #
  # ⚠️ 서버 쪽 두 번째 겹(관측 풀의 connection-init-sql)은 운영 풀에 걸지 않는다. 같은 날 실측:
  #                                 max_execution_time=1000   setQueryTimeout(1)
  #     SELECT SLEEP(5)             1.1s 에 잘림 (ER 3024)     1.03s 에 잘림
  #     UPDATE / INSERT .. SLEEP(5) 안 잘림 (5.0s 완주)         1.18s 에 잘림
  #     락 걸린 행 SELECT..FOR UPDATE 1.0s 에 잘림 (ER 3024)     1.02s 에 잘림
  #     락 걸린 행 UPDATE            안 잘림                    1.03s 에 잘림
  #    즉 서버 상한은 운영 풀이 하는 일(쓰기)은 못 막고 락 대기만 끊는다. 위 socketTimeout 주석이
  #    경고한 함정과 같은 자리라, 관측 풀과 형태를 맞추는 것이 여기서는 손해다.
  #
  # ⚠️ 1초 미만을 적으면 안 된다. JDBC 는 초 단위이고 0 은 '제한 없음' 이다. MainDataSourceConfig
  #    는 그래서 내리지 않고 올린다(500ms → 1s) — 순정 Boot 는 내려서 0, 즉 무제한이 된다.
  #
  # TODO(후속 티켓): v1 부하 측정에서 아카이브·전이 문장의 p99 를 확보한 뒤 이 키를 다시 본다.
  # jdbc:
  #   template:
  #     query-timeout: ?s

  jpa:
    hibernate:
      ddl-auto: validate   # 스키마의 주인은 Flyway
    open-in-view: false
    properties:
      hibernate:
        jdbc:
          time_zone: UTC   # 서버 default-time-zone='+00:00' 과 일치
          batch_size: 100
        order_inserts: true
        order_updates: true
        default_batch_fetch_size: 100

  flyway:
    # 마이그레이션은 @Primary(운영) 풀로 돈다. 관측 풀은 read-only 라 여기 쓰이면 안 된다.
    #
    # ⚠️ enabled 는 여기 두지 않는다. 이 파일은 spring.config.import 로 들어가는데,
    #    import 로 들어온 문서가 그것을 선언한 문서보다 우선한다. 여기 적으면 각 모듈이
    #    자기 파일에 적은 값이 에러도 경고도 없이 무시된다 — batch 의 enabled: false 가
    #    실제로 그렇게 무시되고 있었다. '누가 마이그레이션을 소유하는가' 는 모듈마다
    #    다르므로 각 모듈이 선언한다 (api: true / batch: false).
    locations: classpath:db/migration
    baseline-on-migrate: false   # 기존 테이블이 있는 DB 에 처음 붙일 때만 true
    validate-on-migrate: true
    clean-disabled: true
    placeholder-replacement: false   # DDL 의 ${...} 를 Flyway 가 치환하지 않도록

# 관측 전용 풀. 대시보드 집계 조회가 운영 풀을 점유하면 v1/v2/v3 성능 비교가 무효가 된다.
# 접속 대상은 같은 MySQL 이라 CPU·I/O·버퍼풀은 여전히 공유다 — 풀 분리는 절반의 방어일 뿐이다.
#
# 여기로 보낼 것 : 대시보드가 읽는 집계·조회 (OBS-5 도메인 Gauge · OBS-14b · A 의 조회)
# 여기로 안 보낼 것 : 검증 배치 전부. asof_state 생성(Step 0)은 INSERT 라 read-only 풀에서 돌지
#   않고, V1~V6 과 3축 대조는 판정 결과를 남기는 경로라 운영 풀이 주인이다.
#
# ⚠️ TLS 는 별도 티켓이다. 아래 URL 의 useSSL=false + allowPublicKeyRetrieval=true 조합은
#    caching_sha2_password 에서 "TLS 없이 서버가 준 공개키로 암호를 보낸다" 는 뜻이다.
#    운영 URL(위)도 같은 상태라 관측만 고치면 실익이 없어, 두 줄을 같이 정리하는 티켓으로 뺐다.
#
# ⚠️ 이 블록은 켠 모듈에서만 쓰인다. storage 를 얹었다고 관측 풀이 생기지는 않는다 —
#    각 모듈이 자기 파일에서 observation.datasource.enabled: true 로 옵트인해야 한다.
#    (api·batch 둘 다 켠다. batch 는 대시보드를 그리지 않지만 도메인 Gauge(OBS-5)가 여기로 나간다.)
#    끈 모듈에서는 아래 값이 전부 무시되고 관측 계정도 필요 없다.
#
# ⚠️ 이 URL 을 리플리카로 바꾸지 말 것. 복제 지연이 asOf 시점을 찢어서, 정상 데이터가
#    "비결정적" 으로 오진된다. 리플리카를 쓰려면 asOf 규약부터 다시 정해야 한다.
observation:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 관측은 락을 기다릴 일이 없다. 운영보다 훨씬 짧게 잡는다.
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:app}?serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&useSSL=false&allowPublicKeyRetrieval=true&connectTimeout=${OBS_CONNECT_TIMEOUT_MS:2000}&socketTimeout=${OBS_SOCKET_TIMEOUT_MS:5000}
    # JDBC 쪽 타임아웃. 서버 쪽은 아래 connection-init-sql 이 건다.
    query-timeout: 3s
    # 운영 계정으로 폴백하지 않는다. 폴백하면 관측이 read-write 계정으로 붙는데, hikari 의
    # read-only 는 세션 속성일 뿐 권한이 아니라서 아무것도 못 막는다. 값이 비면 @NotBlank 가
    # 기동을 막는다 — 늦게 죽는 것보다 낫다.
    #
    # TODO(별도 티켓): SELECT 권한만 가진 계정을 실제로 만들어야 한다. 지금 저장소에는 CREATE USER · GRANT 산출물이 없어서, 운영자가 손으로 만든
    #   계정을 주입하는 전제다. 권한이 실제로 SELECT 뿐인지 확인하는 자동 검증도 그 티켓이다.
    username: ${DB_OBS_USERNAME:}
    password: ${DB_OBS_PASSWORD:}
    hikari:
      # 여러 문장을 한 트랜잭션으로 묶는 집계와 1초 폴링 조회가 동시 주체다. 1개면 집계가 도는
      # 동안 폴링이 계속 타임아웃난다. 운영 풀 10 대비 잠식은 이 정도가 한계다.
      maximum-pool-size: 2
      # 오래 걸리면 대기시키지 않고 실패시킨다. 대기하면 스냅샷 스케줄러가 밀린다.
      connection-timeout: 2000
      validation-timeout: 2000
      keepalive-time: 30000
      max-lifetime: 580000
      read-only: true
      # 서버 쪽 상한. 클라이언트 타임아웃만 두면 커넥션만 끊기고 MySQL 은 그 쿼리를 끝까지 돌린다 —
      # 인덱스 없는 대용량 스캔이 버퍼풀을 갈아엎으면 풀을 나눠도 v1 측정이 오염된다.
      connection-init-sql: SET SESSION max_execution_time = 3000
      # 미터의 pool 태그로 관측 쿼리가 운영 풀을 안 쓰는지 확인한다. JVM 별로 다른 이름을 준다.
      pool-name: ${OBS_POOL_NAME:obs-pool}
