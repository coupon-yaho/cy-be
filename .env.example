# compose.yml 이 요구하는 환경변수. 실제 값은 .env 에 넣는다(gitignore 대상).
#   cp .env.example .env  후 비밀번호를 채운다.

# 이미지 — main 의 docker-publish 워크플로가 밀어 올린 것
COUPON_IMAGE=<dockerhub-user>/coupon-yaho
API_IMAGE_TAG=api-latest
BATCH_IMAGE_TAG=batch-latest

# MySQL
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=<채울 것>
MYSQL_ROOT_PASSWORD=<채울 것>
MYSQL_PORT=3306

# 로컬 Redis — 호스트에서 IDE/Gradle로 실행할 때 localhost:${REDIS_PORT}로 접속한다.
# compose 내부 API는 서비스 DNS(redis):6379를 사용한다.
REDIS_PORT=6379

# 앱이 보는 DB 접속 정보 (컨테이너 네트워크 기준)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=<채울 것>
# 관측 전용 계정 — SELECT 만 가능해야 한다.
# compose 로 띄우면 이 두 값으로 계정이 자동 생성된다
# (infra/mysql/initdb/20-obs-account.sh, 빈 볼륨에서만 실행).
# 운영 DB 는 그 스크립트와 같은 권한을 갖춰야 한다 — GRANT SELECT ON <스키마>.* 하나다.
# 테이블 단위로 열거하면 BATCH_JOB_EXECUTION · BATCH_JOB_INSTANCE 가 빠지기 쉽다.
# ⚠️ 계정 이름은 영숫자·밑줄만 쓴다. 위 스크립트가 그 밖의 문자를 거부하고 기동을 멈춘다 —
#    예전에 <select-only-user> 라는 플레이스홀더를 두었더니 .env.example 을 그대로 복사한
#    신규 환경에서 mysqld 초기화가 실패했다. 비밀번호는 그 제약이 없다.
DB_OBS_USERNAME=obs
DB_OBS_PASSWORD=<채울 것>

# 포트. 각 모듈 설정과 PrometheusScrapeConfigContractTest가 고정한 값이다.
#   api 8080=업무(호스트 공개) · 9090=actuator(비공개)
#   batch 9091=verify 업무(비공개) · 9092=actuator(비공개)
# ⚠️ SERVER_PORT 와 API_HOST_PORT 는 다른 뜻이다. 예전에는 한 이름이 두 자리에서 두 뜻으로
#    쓰였고(호스트 공개 포트 · 컨테이너 Spring 포트), compose 가 컨테이너 값을 "8080" 으로
#    덮어써서 버텼다 — 어느 쪽을 고쳐도 반대쪽이 깨지는 상태였다.
#      SERVER_PORT    = 컨테이너 안 Spring 이 듣는 포트. api/src/main/resources/application.yml.example
#                       의 ${SERVER_PORT:8080} 이 읽는 값이 이것이다.
#      API_HOST_PORT  = 그 포트를 호스트 어느 번호로 내보낼지. compose 의 ports 왼쪽만 쓴다.
#    호스트에서 8080 이 이미 물려 있으면 API_HOST_PORT 만 바꾼다 — 앱은 계속 8080 에서 듣는다.
SERVER_PORT=8080
API_HOST_PORT=8080
MANAGEMENT_PORT=9090
BATCH_PORT=9091
# actuator 전용. 이미지 안 batch management.yml 이 정하는 값과 같아야 한다.
BATCH_MANAGEMENT_PORT=9092

# 풀·배치 튜닝
DB_POOL_SIZE=3
BATCH_DB_POOL_SIZE=4
# 현재 compose는 고정 호스트 포트의 단일 API다. 공식 P-1 N=4 배포에서는 4로 덮는다.
BENCHMARK_APP_REPLICAS=1
BENCHMARK_ADMIN_COMMAND_SECRET=
BENCHMARK_ARCHIVE_CLAIM_LEASE=5m
BENCHMARK_ARCHIVE_MAX_SAMPLES=10000
BENCHMARK_ARCHIVE_WRITE_CHUNK_SIZE=500
BENCHMARK_LOAD_HOLD_SECONDS=5
BENCHMARK_OBSERVATION_HOLD_SECONDS=60
# 공식 회차를 열기 전에 그 회차 coupon id로 채운다. 빈 값이면 preflight가 회차를 거부한다.
DOMAIN_GAUGE_COUPON_ID=
BATCH_SCHEDULING_ENABLED=true
ASOF_STATE_KEEP_RUNS=5
VERIFY_CHUNK_SIZE=200000
ADMIN_ANALYTICS_MAX_RANGE_YEARS=1

# ── OBS-17 Kafka 설정 계층 ─────────────────────────────────────────────
# 브로커가 있는 회차에만 켠다. RF3 · ISR2 를 선언하므로 브로커 3대가 전제다 —
# 1대짜리 로컬에서 켜면 토픽 생성이 INVALID_REPLICATION_FACTOR 로 실패한다.
KAFKA_ENABLED=false
# 호스트에서 IDE/Gradle 로 실행할 때의 값이다. compose 내부 API 는 서비스 DNS(kafka:9092)를 써야
# 한다 — 컨테이너 안의 localhost 는 api 자신이다. Redis 가 REDIS_HOST 를 compose 에서 덮는 것과
# 같은 구조이므로, 브로커 서비스를 compose 에 추가할 때 여기도 함께 덮을 것.
#
# ⚠️ 비워 두지 말 것. Spring 의 ${VAR:기본값} 은 변수가 "정의되지 않았을 때" 만 기본값을 쓴다 —
#    빈 문자열로 정의하면 그 빈 값이 이겨서, KAFKA_ENABLED=true 로 켜는 순간 기동에서 죽는다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# 기동을 마친 뒤 별도 실행기가 토픽을 만들고 선언대로인지 확인한다. 끄면 선언만 하고
# 만들지도 확인하지도 않는다 — 브로커의 auto.create.topics.enable 이 켜져 있으면
# RF1 토픽이 대신 생기고 아무도 모른다.
KAFKA_PROVISION_TOPICS=true
