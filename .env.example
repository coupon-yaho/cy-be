# compose.yml 이 요구하는 환경변수. 실제 값은 .env 에 넣는다(gitignore 대상).
#   cp .env.example .env  후 비밀번호를 채운다.

# 이미지 — main 의 docker-publish 워크플로가 밀어 올린 것
COUPON_IMAGE=<dockerhub-user>/coupon-yaho
API_IMAGE_TAG=api-latest
BATCH_IMAGE_TAG=batch-latest

# MySQL
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=<채울 것>
MYSQL_ROOT_PASSWORD=<채울 것>
MYSQL_PORT=3306

# 로컬 Redis — 호스트에서 IDE/Gradle로 실행할 때 localhost:${REDIS_PORT}로 접속한다.
# compose 내부 API는 서비스 DNS(redis):6379를 사용한다.
REDIS_PORT=6379
# Redis 타임아웃의 정본은 infra/redis 의 redis.yml 이다. api·batch 가 같은 값을 공유한다.
# 명령 타임아웃은 batch 의 재고 수집 주기(1초)보다 짧아야 한다 — 길면 다음 수집이 밀린다.
# ⚠️ **비워 둔다.** 채우면 클라이언트만 AUTH 를 보내는데 서버가 무인증이라 Redis 가
#    "ERR AUTH ... called without any password configured" 로 거부하고 api·batch 기동이
#    깨진다(실측). 서버 쪽 배선은 세 곳을 함께 고쳐야 한다 — docs/12-v2-redis-design.md §6.1.2.
REDIS_PASSWORD=
# Sentinel 이 감시할 master 주소와 그 주소가 속한 대역. **둘은 함께 바꾼다.**
# 기본값은 Docker 기본 주소 풀(172.17~172.31/16) 안이라 다른 compose 네트워크와 겹칠 수
# 있다 — "network ... overlaps" 로 기동이 실패하면 두 값을 함께 옮긴다.
# sentinel.conf 의 감시 대상은 REDIS_MASTER_IP 로 주입되므로 따로 고칠 것이 없다.
REDIS_SUBNET=172.31.240.0/24
REDIS_MASTER_IP=172.31.240.10
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=500ms
# IDE/Gradle 기본은 위 단일 Redis다. compose는 아래 값을 redis-sentinel-1~3로 덮어
# failover 경로를 검증한다. Sentinel은 가용성만 제공하고 유실 재고는 CY-760 재구성이 회수한다.
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_NODES=
# redisCB: 요청 안에서 재시도하지 않는다. 운영 부하 회차별 튜닝값은 여기에 명시한다.
REDIS_CB_SLIDING_WINDOW_SIZE=5
REDIS_CB_MINIMUM_NUMBER_OF_CALLS=5
REDIS_CB_FAILURE_RATE_THRESHOLD=100
REDIS_CB_WAIT_DURATION_IN_OPEN_STATE=1s

# 앱이 보는 DB 접속 정보 (컨테이너 네트워크 기준)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=<채울 것>
# 관측 전용 계정 — SELECT 만 가능해야 한다.
# compose 로 띄우면 이 두 값으로 **계정만** 자동 생성된다
# (infra/mysql/initdb/20-obs-account.sh, 빈 볼륨에서만 실행). 권한은 거기서 안 준다.
#
# ⚠️ [OBS-36] **권한을 손으로 주지 말 것.** 특히 스키마 단위(`... ON <스키마>.*`)로 주면
#    이 계정이 members 까지 읽는다 — 관측 경로는 그 테이블을 한 곳도 읽지 않는데도.
#    개인정보 컬럼은 암호화돼 있지만 HMAC 블라인드 인덱스(email_hash · phone_hash)로
#    동일인 대조가 되고 membership_grade · created_at 은 평문이다.
#
#    권한은 양성 목록으로만 준다. 목록의 정본은 infra/mysql/obs-grants/allowlist.txt 이고,
#    부여는 **앱이 한 번 떠서 Flyway 마이그레이션이 끝난 뒤** 한 번 친다:
#      docker compose --profile obs-grants run --rm obs-grants
#
#    운영 DB 도 같다 — 같은 스크립트(infra/mysql/obs-grants/apply.sh)를 쓴다. 손으로 옮겨
#    적지 않는다. 그 스크립트가 예전 스키마 GRANT 를 걷어내는 일까지 함께 한다.
#    실행 시점과 미실행 시 증상은 README 의 "관측 계정 권한 재부여" 절에 있다.
# ⚠️ 계정 이름은 영숫자·밑줄만 쓴다. 위 스크립트가 그 밖의 문자를 거부하고 기동을 멈춘다 —
#    예전에 <select-only-user> 라는 플레이스홀더를 두었더니 .env.example 을 그대로 복사한
#    신규 환경에서 mysqld 초기화가 실패했다. 비밀번호는 그 제약이 없다.
DB_OBS_USERNAME=obs
DB_OBS_PASSWORD=<채울 것>

# 포트. 각 모듈 설정과 PrometheusScrapeConfigContractTest가 고정한 값이다.
#   api 8080=업무(호스트 공개) · 9090=actuator(비공개)
#   batch 9091=verify 업무(비공개) · 9092=actuator(비공개)
#   kafka 9092=브로커 · 9093=컨트롤러 — 둘 다 compose 내부 전용이라 호스트 포트가 없다
#
# ⚠️ SERVER_PORT 와 API_HOST_PORT 는 다른 뜻이다. 예전에는 한 이름이 두 자리에서 두 뜻으로
#    쓰였고(호스트 공개 포트 · 컨테이너 Spring 포트), compose 가 컨테이너 값을 "8080" 으로
#    덮어써서 버텼다 — 어느 쪽을 고쳐도 반대쪽이 깨지는 상태였다.
#      SERVER_PORT    = 컨테이너 안 Spring 이 듣는 포트. api/src/main/resources/application.yml.example
#                       의 ${SERVER_PORT:8080} 이 읽는 값이 이것이다.
#      API_HOST_PORT  = 그 포트를 호스트 어느 번호로 내보낼지. compose 의 ports 왼쪽만 쓴다.
#    호스트에서 8080 이 이미 물려 있으면 API_HOST_PORT 만 바꾼다 — 앱은 계속 8080 에서 듣는다.
SERVER_PORT=8080
API_HOST_PORT=8080
MANAGEMENT_PORT=9090
BATCH_PORT=9091
# actuator 전용. 이미지 안 batch management.yml 이 정하는 값과 같아야 한다.
BATCH_MANAGEMENT_PORT=9092

# 풀·배치 튜닝
DB_POOL_SIZE=13
BATCH_DB_POOL_SIZE=4
BENCHMARK_HIKARI_POOL_TOTAL=52
BENCHMARK_MYSQL_MAX_CONNECTIONS=151
# 현재 compose는 고정 호스트 포트의 단일 API다. 공식 P-1 N=4 배포에서는 4로 덮는다.
BENCHMARK_APP_REPLICAS=1
BENCHMARK_ADMIN_COMMAND_SECRET=
BENCHMARK_ARCHIVE_CLAIM_LEASE=5m
BENCHMARK_ARCHIVE_MAX_SAMPLES=10000
BENCHMARK_ARCHIVE_WRITE_CHUNK_SIZE=500
BENCHMARK_BATCH_CONSISTENCY_READ_TIMEOUT=10s
BENCHMARK_CONSISTENCY_CLAIM_LEASE=5m
BENCHMARK_CONSISTENCY_MAX_OBSERVATION_LAG=15m
BENCHMARK_LOAD_HOLD_SECONDS=5
BENCHMARK_OBSERVATION_HOLD_SECONDS=60
# 공식 회차를 열기 전에 그 회차 coupon id로 채운다. 빈 값이면 preflight가 회차를 거부한다.
DOMAIN_GAUGE_COUPON_ID=
# 프런트엔드 오리진. 브라우저에서 발급 API 를 부를 때 필요하다.
# 비워 두면 api/application.yml.example 의 기본값(로컬 개발 서버 넷)이 쓰인다.
# 화면을 다른 호스트에서 띄우면 그 오리진을 쉼표로 나열한다.
API_CORS_ORIGINS=

# ── CY-742 관리자 API 토큰 관문 ─────────────────────────────────
# ⚠️ **비우면 batch 가 기동에서 죽는다.** 관문 기본값이 켜짐(required:true)인데 토큰이
#    빈 문자열이면 adminTokenFilter 생성이 IllegalState 로 실패하고, restart: unless-stopped
#    라 한 번 죽고 마는 게 아니라 **크래시루프**에 빠진다. compose ps 에는 "Restarting" 만
#    보이고 이유는 docker logs batch 에만 있다(실측 2026-08-30).
#
#    batch 가 안 뜨면 **v2 회차를 아예 못 연다** — 워밍업이 batch 에 있다.
#
#    포트를 밖으로 안 낼 거라면 BATCH_ADMIN_AUTH_REQUIRED=false 로 명시해도 된다.
#    다만 기본 구성은 값을 주는 쪽이다 — 나중에 포트를 여는 날 관문이 이미 서 있어야 한다.
BATCH_ADMIN_TOKEN=<채울 것>

BATCH_SCHEDULING_ENABLED=true
ASOF_STATE_KEEP_RUNS=5
VERIFY_CHUNK_SIZE=200000
ADMIN_ANALYTICS_MAX_RANGE_YEARS=1

# v2 게이트의 -7(같은 멱등키가 처리 중)·-9(재구성 창) 응답에 붙는 Retry-After 초.
# 서버가 대신 기다리지 않고 클라이언트가 기다리게 하는 값이다. 스파이크에서 재시도가
# 한 초 격자에 정렬돼 두 번째 봉우리를 만들면 여기서 늘린다 — 코드는 그대로라 회차 간
# 비교가 성립한다(반영에는 api 재기동이 필요하다).
OBSERVATION_REPLAY_PENDING_RETRY_AFTER=1
OBSERVATION_GATE_NOT_READY_RETRY_AFTER=1
OBSERVATION_REDIS_UNAVAILABLE_RETRY_AFTER=1

# 외부 대기열 게이트웨이 상태 공급. 활성화할 때 인스턴스별 안전 상한을 반드시 양수로 둔다.
QUEUE_GATEWAY_PUBLISHER_ENABLED=false
QUEUE_GATEWAY_CAPACITY_INTERVAL=1s
QUEUE_GATEWAY_COUPON_ROUND_INTERVAL=5s
QUEUE_GATEWAY_CREDITS_PER_SECOND=0
# 기본값은 컨테이너 HOSTNAME이며 로컬에서는 api-local이다. 고정해야 할 때만 덮어쓴다.
# QUEUE_GATEWAY_INSTANCE_ID=api-local

# 외부 게이트웨이 지표를 관리자 관제 API에 연결한다. 실제 target을 배치한 환경에서만 켠다.
QUEUE_GATEWAY_PROMETHEUS_ENABLED=false
# 마지막 게이트웨이 관측 이후 이 시간이 지나면 STALE로 판정한다. 반드시 양수여야 한다.
QUEUE_GATEWAY_PROMETHEUS_STALE_AFTER=5s

# ── OBS-17 Kafka 설정 계층 ─────────────────────────────────────────────
# 브로커가 있는 회차에만 켠다. RF3 · ISR2 를 선언하므로 브로커 3대가 전제다 —
# 1대짜리 로컬에서 켜면 토픽 생성이 INVALID_REPLICATION_FACTOR 로 실패한다.
#
# OBS-35 부터 compose 가 브로커 3대(kafka-1·2·3)를 함께 띄우므로, docker compose 로 스택을
# 통째로 올리는 회차는 이 값을 true 로 켤 수 있다. 호스트에서 IDE/Gradle 로 앱만 띄우는
# 회차는 브로커에 닿지 못하므로 false 로 둔다(아래 KAFKA_BOOTSTRAP_SERVERS 주석 참조).
#
# 켠 뒤 확인은 지표 하나로 한다 — 컨테이너 안에서
#   docker exec coupon-yaho-api-1 wget -qO- localhost:9090/actuator/prometheus \
#     | grep app_kafka_topics_provisioned
# app_kafka_topics_provisioned 가 1 이면 끝이다. 값이 없으면 짝이 되는 _state 와
# _cause 가 이유를 낸다(unconfirmed=기다리면 낫는다 · mismatched=재기동으로 안 낫는다).
KAFKA_ENABLED=false
# 호스트에서 IDE/Gradle 로 실행할 때의 값이다. compose 내부 API 는 서비스 DNS 를 쓰고, 그 값은
# compose.yml 의 api.environment 가 kafka-1:9092,kafka-2:9092,kafka-3:9092 로 덮는다 —
# 컨테이너 안의 localhost 는 api 자신이다(REDIS_HOST 와 같은 구조).
#
# ⚠️ 브로커에는 호스트 공개 포트가 없다. Kafka 에 인증이 없어서 여는 순간 아무나 발급 이벤트를
#    위조해 넣을 수 있기 때문이다. 그래서 호스트에서 IDE/Gradle 로 띄운 앱은 브로커에 닿지
#    못한다 — 그 회차는 아래 KAFKA_ENABLED 를 false 로 둔 채 쓴다. 아래 주소는 그 제약이
#    풀렸을 때(예: 임시로 ports 를 여는 실험)를 위한 자리표시자이지, 지금 닿는 주소가 아니다.
#
# ⚠️ 비워 두지 말 것. Spring 의 ${VAR:기본값} 은 변수가 "정의되지 않았을 때" 만 기본값을 쓴다 —
#    빈 문자열로 정의하면 그 빈 값이 이겨서, KAFKA_ENABLED=true 로 켜는 순간 기동에서 죽는다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# 기동을 마친 뒤 별도 실행기가 토픽을 만들고 선언대로인지 확인한다. 끄면 선언만 하고
# 만들지도 확인하지도 않는다 — 브로커의 auto.create.topics.enable 이 켜져 있으면
# RF1 토픽이 대신 생기고 아무도 모른다.
KAFKA_PROVISION_TOPICS=true

# 마운트한 배포 설정이 실제로 실렸는지 기동 때 확인할지. **compose.yml 이 서비스마다 직접
# 주므로 여기 값은 안 쓰인다** — 손잡이의 존재를 알리려고 적어 둔다.
#
# 왜 필요한가: compose 가 ./application.yml 을 bind mount 하는데 그 파일이 없으면 Docker 가
# 같은 이름의 **디렉터리**를 만들어 붙인다. 스프링은 그것을 오류 없이 무시하고, 그다음
# observation.datasource.url must not be blank 처럼 **원인과 먼 자리**에서 죽는다.
# 2026-08-30 에 그 메시지를 쫓느라 시간을 썼다.
#
# 끄면 그 옛 동작으로 돌아간다. 설정을 마운트하지 않는 배포 경로
# (base.yml + batch.yml 의 batch — 실측)에서만 끈다.
DEPLOYED_CONFIG_REQUIRED=true
