spring:
  application:
    name: coupon-batch
  config:
    import: classpath:storage.yml

  main:
    web-application-type: none

  batch:
    jdbc:
      initialize-schema: never   # 배치 메타 테이블도 Flyway 로 관리
    job:
      enabled: false

  # 마이그레이션 소유자는 api 하나로 고정한다.
  flyway:
    enabled: false

logging:
  level:
    com.kafkick: DEBUG

coupon:
  expiration:
    cron: "${COUPON_EXPIRATION_CRON:0 * * * * *}"
    zone: ${COUPON_EXPIRATION_ZONE:UTC}
    chunk-size: ${COUPON_EXPIRATION_CHUNK_SIZE:500}

  round-generation:
    schedule-zone: ${COUPON_SCHEDULE_ZONE:Asia/Seoul}
    max-days: ${COUPON_GENERATION_MAX_DAYS:30}
