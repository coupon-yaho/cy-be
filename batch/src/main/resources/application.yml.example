spring:
  application:
    name: coupon-batch
  config:
    import: classpath:storage.yml

  main:
    web-application-type: none

  batch:
    jdbc:
      initialize-schema: never   # 배치 메타 테이블도 Flyway 로 관리
    job:
      enabled: false

  # 마이그레이션 소유자는 api 하나로 고정한다.
  flyway:
    enabled: false

logging:
  level:
    com.kafkick: DEBUG
