#
# ⚠️ 이 파일은 문서가 둘이다. 맨 아래 `---` 를 지우지 마라.
#
#   spring.config.import 로 들어온 storage.yml 은 **그것을 선언한 문서보다 우선한다.**
#   그래서 이 첫 문서에 storage.yml 과 같은 키를 적으면 조용히 무시된다 — 에러도 경고도 없다.
#   실제로 spring.flyway.enabled: false 와 maximum-pool-size: 4 가 그렇게 죽어 있었다.
#
#   storage.yml 을 덮어쓸 값만 `---` 아래 두 번째 문서에 둔다. 뒤 문서가 이긴다.
#   나머지는 전부 이 첫 문서에 둔다 — 그래야 BatchConfigPrecedenceTest 의 충돌 검사를 받는다.
#
spring:
  application:
    name: coupon-batch
  config:
    import: classpath:storage.yml

  task:
    scheduling:
      pool:
        # @Scheduled 가 여덟이다 — ExpireScheduler.expire(만료 잡을 동기로 끝까지 돌린다),
        # CleanupScheduler.cleanup(정리 잡을 동기로 끝까지 돌린다),
        # VerifyScheduler.verify(검증 잡을 동기로 끝까지 돌린다 — 300만에서 472초다),
        # CouponRoundScheduler.transitionRounds(회차를 열고 닫는다 — 1분),
        # VerificationMetricsRefresher.refresh(판정을 되읽는다),
        # BatchRunMetricsRefresher.refresh(마지막 성공 시각과 멈춘 실행 수를 되읽는다),
        # ExpirePendingRefresher.refresh(만료 대기 건수를 되읽는다),
        # CouponRoundPendingRefresher.refresh(회차 전이 대기 수를 되읽는다).
        #
        # 만료(04:10)·정리(04:30)·검증(05:00)은 서로 떨어져 있어 서로를 막지 않지만,
        # 되읽기 넷과 1분 크론인 회차 전이는 그 사이에도 돌아야 한다 — 그 구간이 관제가
        # 가장 볼 값어치가 있는 시간이다. 특히 검증은 한 번에 8분을 잡고 있는다.
        #
        # 기본값이 1 이라 그대로 두면 만료가 도는 내내 되읽기가 멈추고, 되읽기가 커넥션을
        # 기다리는 동안 만료 크론 발화가 밀린다. 스케줄러 넷(만료·정리·검증·회차 전이)이
        # 서로를 막지 않게 한다.
        #
        # **여유를 안 둔다 — DB 풀과 다른 축이다.** 커넥션 풀은 keepalive·health 체크처럼
        # 우리가 안 세는 소비자가 붙어서 여유 둘을 뒀지만, 이 풀을 쓰는 것은 @Scheduled
        # **여덟뿐**이고 아홉째가 생기려면 코드가 바뀌어야 한다. 그때 이 값도 함께 올리라는
        # 신호가 되도록 정확히 그 수로 둔다 — 여유를 두면 그 신호가 사라진다.
        # (CY-421 이 ExpirePendingRefresher 를 더하면서 넷에서 다섯이 됐다. 신호가 일했다.
        #  CY-446 이 둘을 더하면서 일곱이 됐는데, 그때는 **신호를 한 번 지나쳤다** —
        #  리뷰가 @Scheduled 를 전수 세어 잡았다. 숫자가 코드와 함께 움직여야 신호가 산다.
        #  CY-470 이 VerifyScheduler 를 더해 여덟이 됐다.)
        #
        # ⚠️ 이 키는 Boot 가 직접 소비해서 @Value 스캔에 안 잡힌다. 그래서 둘이 함께 지킨다 —
        #    ResolvedBatchConfigTest 가 해석된 Environment 값을(키 경로),
        #    VerificationMetricExposureTest.schedulerPoolFitsScheduledTaskCount 가
        #    실제 스케줄러 빈의 코어 크기를(값이 정말 쓰이는지) 본다.
        #    앞의 것만으로는 "적힌 값이 떴다" 까지고, 그 값을 스케줄러가 쓴다는 보장이 아니다.
        size: ${BATCH_SCHEDULER_POOL_SIZE:8}

  # CY-368 이 업무 포트에 검증 트리거 컨트롤러를 열었다(POST /api/v1/admin/verify).
  # 인증이 없어서 compose 가 그 포트를 **기본으로 호스트에 안 내보낸다** —
  # batch-expose.yml 을 얹을 때만 열린다. 근거는 docs/15 결정 1.
  #
  # servlet 으로 두는 것은 뒤에 올 verify 온디맨드 트리거(POST /api/v1/admin/verify)를
  # 미리 받기 위한 것이다. 관리 포트는 아래 management 블록이 따로 연다 —
  # 그 키는 storage.yml 에 없으므로 예고대로 뒤 문서가 아니라 이 첫 문서에 둔다.
  #
  # ⚠️ **CY-368 이 둘 중 후자로 정했다** — compose 의 업무 포트 매핑을 없앴다.
  #   앞의 것(커스텀 actuator 로 관리 포트에 올리기)은 경로가 /actuator/verify 가 되어
  #   프론트 계약(docs/05 의 POST /api/v1/admin/verify)이 깨진다. 근거는 docs/15 결정 1.
  #
  #   **그래도 인증은 없다.** PRD 는 이 상태를 /actuator/env 와 같은 급의 구멍으로 묶고
  #   "관리 포트 분리 + ADMIN 역할" 을 대응으로 적었는데, 토큰 규약은 다른 영역의 몫이라
  #   여기서 혼자 정하면 두 벌이 된다. 노출 축소가 막는 것은 **인터넷뿐**이고,
  #   같은 compose 네트워크 안에서는 그대로 닿는다.
  #   밖에 안 나가는 것은 관리 포트뿐이다. 그 이상을 이 파일이 약속하지 않는다.
  main:
    web-application-type: servlet

  batch:
    # spring.batch.jdbc.* 는 두지 않는다 — Boot 4.1 에 그 프로퍼티 그룹이 없다.
    # BatchProperties 의 중첩 클래스가 Job(name) 하나뿐이고 배치 스키마 이니셜라이저도
    # 모듈에서 사라졌다. 예전에 initialize-schema: never 를 적어 두었는데 아무것도
    # 안 읽고 있었다. 메타 테이블은 V11__batch_metadata.sql 이 만든다.
    job:
      enabled: false             # 기동 시 Job 자동 실행 금지. 스케줄러와 API 만 띄운다

  datasource:
    hikari:
      # 미터의 pool 태그가 api 것인지 batch 것인지 가른다.
      # storage.yml 에 같은 키가 없어 덮어쓰기가 아니다 — 그래서 아래가 아니라 여기에 둔다.
      # storage.yml 이 나중에 pool-name 을 정의하면 충돌 검사가 잡는다.
      pool-name: batch-pool

      # ⚠️ **HikariCP 는 minimum-idle 기본이 maximum-pool-size 다.** 안 주면 컨텍스트가
      #    뜨자마자 풀 크기만큼 전부 열고 놓지 않는다. 운영은 프로세스가 하나라 상관없지만,
      #    테스트는 스프링 컨텍스트가 캐시돼 동시에 여러 개가 살아 있고 **MySqlContainerConfig
      #    가 컨테이너를 컨텍스트마다 하나씩 띄운다**(@Bean 이고 static 홀더도 withReuse 도 없다).
      #    그래서 풀을 4 에서 8 로 올린 것이 mysqld 마다 커넥션 버퍼로 곱해져 기계를 밀어냈고,
      #    컨테이너가 죽어 `Connection refused` 가 났다. 증상이 "테스트가 틀렸다" 가 아니라
      #    기동 실패로 보여 원인까지 가는 길이 멀다 — 실패 문자열의 `total=0, idle=0` 이
      #    "풀이 말랐다" 가 아니라 "서버가 없다" 를 뜻한다는 것이 유일한 단서였다.
      #
      #    2 면 평소에는 둘만 들고 있다가 필요할 때 maximum-pool-size 까지 늘린다.
      #    storage.yml 에 같은 키가 없어 덮어쓰기가 아니다 — 그래서 아래가 아니라 여기에 둔다.
      minimum-idle: ${BATCH_DB_MIN_IDLE:2}

server:
  port: ${BATCH_PORT:9090}
  error:
    # 이 티켓의 요청 범위 밖이지만 같은 파일·같은 성격이라 같이 넣는다.
    # batch 는 starter-web 을 갖고 있어 예외가 응답으로 나갈 표면이 원래 있었다.
    include-stacktrace: never

# 업무 포트와 관측 포트를 나눈다. 한 포트에 얹으면 verify 트리거와 지표가 같은 문에 걸려,
# 그 문을 열고 닫는 판단이 하나로 묶인다.
#
# ⚠️ compose 를 쓰는 사람에게 — 세 숫자가 각각 다른 뜻이다.
#
#     호스트 9090  →  컨테이너 9090   업무 (verify 트리거).  이게 맞다
#        내보내지 않음  컨테이너 9092   관리 (actuator)
#
#   `ports:` 의 우변은 언제나 9090 이다. 호스트 쪽 번호는 BATCH_HOST_PORT 이고
#   batch.yml 의 기본값도 9090 이다(README 의 포트 표와 같다).
#   관리 포트를 호스트에 매핑하면 인증 없이 전 지표가 열린다.
#
#   관제의 스크레이프 대상은 컨테이너 기준 batch:9092 다 — 내부 네트워크에서 긁는다.
#   infra/prometheus/prometheus.yml 의 targets 와 같아야 한다.
#
#   9091 → 9092 로 옮긴 것은 CY-254 와 맞춘 것이다. 예전에는 관리 포트도 9091 이라
#   호스트 업무 포트와 숫자가 겹쳐서, `ports: - "9091:9091"` 로 쓰면 관리 포트가
#   호스트에 열리고 업무 포트는 아무도 못 가리키는 사고가 났다.
#
# Compose 에 이 포트를 매핑하지 마라. Prometheus 가 내부 네트워크에서 긁는다.
# 호스트로 내보내면 인증 없이 전 지표가 열린다.
management:
  server:
    port: ${BATCH_MANAGEMENT_PORT:9092}
  endpoints:
    web:
      exposure:
        # 지금 /actuator/env 를 막는 것은 exclude 가 아니라 include 다 — 화이트리스트라
        # 여기 없는 것은 애초에 안 열린다. include 를 넓히지 마라. env 는 AES 키를 평문으로
        # 내보낸다.
        #
        # exclude 는 그럼에도 남긴다. 누가 include 를 * 로 바꾸는 날의 이중 방어다.
        # 그 상황을 ActuatorWildcardExposureTest 가 재현해서 이 줄을 지킨다.
        include: health,metrics,prometheus
        # include 가 * 로 넓어지는 날 실제로 열리는 것을 재 봤다 — 16개다. 그중 위험한 것을
        # 전부 적는다. loggers 는 읽기가 아니라 **쓰기**다(POST 로 런타임 로그 레벨 변경).
        # 나머지는 정찰용이다 — 마이그레이션 이력·의존성 목록·크론 구조·스레드 덤프.
        #
        # 이 목록이 방어의 본체는 아니다. 스프링이 엔드포인트를 추가하면 목록은 낡는다.
        # 본체는 include 화이트리스트고, ActuatorExposureTest 가 **열린 것의 집합 전체**를
        # 단언해 그것을 지킨다.
        exclude: env,configprops,beans,heapdump,loggers,threaddump,mappings,scheduledtasks,conditions,flyway,sbom
  endpoint:
    health:
      # 상세를 켜면 DB 접속 정보와 컴포넌트 구성이 그대로 나간다.
      show-details: never

batch:
  cleanup:
    # 한 번에 지우는 asof_state 행 수 = **한 트랜잭션**이다. 태스클릿 한 번이 청크 하나이고,
    # CONTINUABLE 로 돌아올 때마다 새 트랜잭션이 열려 앞 청크는 커밋된 채 남는다.
    # 한 문장으로 300만을 지우면 언두 로그가 부풀고 그 트랜잭션이 오래 잠기는데,
    # **커밋을 안 나누면 LIMIT 을 붙여도 결과가 같다** — 그래서 진도를 실행 컨텍스트에 남긴다.
    #
    # ⚠️ 1 이상이어야 한다. 0 이면 DELETE … LIMIT 0 이 항상 0행이라 asof_state 를 한 행도
    #    안 지운 채 잡이 COMPLETED 로 닫힌다 — CleanupNotSucceeding 도 안 울어서 가장 무거운
    #    테이블만 안 걷히는 상태가 감시망을 통째로 통과한다. 기동 때 거절한다.
    chunk-size: ${CLEANUP_CHUNK_SIZE:10000}

    # ── 배치 메타(BATCH_*) 보존 ──────────────────────────────────────────────
    # 끝난 지 이만큼 지난 JobExecution 과 딸린 행을 cleanupJob 의 둘째 Step 이 걷는다.
    #
    # ⚠️ **최소 8 이다(= 되읽기 창 7일 초과) — 그 아래는 기동 때 거절한다.** BatchRunMetricsRefresher 와
    #    ExpirePendingRefresher 가 마지막 성공 실행을
    #    END_TIME > NOW() - INTERVAL 7 DAY 창에서 찾는다. 보존이 그 창보다 길어야
    #    삭제가 게이지에 영향을 줄 수 없다 — 창이 언제나 구속 조건이 된다.
    #    안쪽으로 내려도 잡이 매일 성공하는 동안은 멀쩡해 보인다. 무너지는 것은 **연속
    #    실패가 보존 기간을 넘긴 날**이다 — 마지막 성공이 지워져 '며칠 실패' 가
    #    '한 번도 성공한 적 없음'(NaN)으로 보고되고 ExpireNeverSucceeded(critical)가 뜬다.
    #    그 창은 두 되읽기의 SQL 에 리터럴로 있어 코드가 두 값을 못 잇는다.
    #
    # 실행 중이거나 종료 표시를 못 남기고 죽은 행(END_TIME IS NULL)은 안 걷는다.
    # 그것을 지우면 BatchStuckExecution 이 조용해지는데, 고친 게 아니라 증거를 지운 거다.
    metadata-keep-days: ${CLEANUP_METADATA_KEEP_DAYS:30}

    # 한 트랜잭션이 지울 **잡 실행 개수**다. 바로 위 chunk-size(asof_state 행 수)와 뜻이
    # 다르므로 이름을 갈라 뒀다 — 실행 하나에 딸린 행이 잡마다 크게 다르다(verifyJob 은
    # Step 열하나 + 문맥 blob). 10000 을 그대로 쓰면 한 트랜잭션이 27만 행을 들고
    # step-timeout-ms(120초)에 걸리고, 그러면 여태 지운 것이 전부 롤백돼 진도가 0 이라
    # 다음 날도 처음부터 시도한다.
    #
    # ⚠️ 1..5000 이다. 삭제는 id 하나씩 나가므로(CleanupJdbcAdapter) 이 값은
    #    **한 트랜잭션의 문장 수 ÷ 6** 이다. 잠그는 행은 이 값이 아니라 그 실행들에 딸린
    #    행 전부다 — verifyJob 이면 실행 하나에 26행(Step 11 + Step 문맥 11 + 파라미터 1
    #    + 문맥 1 + 실행 1 + 인스턴스 1)이라 5000 이면 13만 행이 한 트랜잭션에 들어간다.
    #    step-timeout-ms 안에 못 들어오면 전량 롤백이라 진도가 0 이다.
    metadata-chunk-size: ${CLEANUP_METADATA_CHUNK_SIZE:500}

    # 판정을 못 내고 열린 채 남은 실행을 언제부터 "버려진 것" 으로 볼 것인가.
    #
    # ⚠️ **이 창은 두 번째 방어선이다.** 첫 번째는 정리 Step 이 청크마다 배치 메타에 묻는
    #    "지금 검증이 도는가"(RunningJobProbe)다. 이 값이 실제 소요보다 짧으면 도는 검증의
    #    입력이 걷히고, 그때 규칙은 빈 상태를 읽고 예외 없이 **조용히 틀린 답**을 낸다.
    #
    # **24 에서 6 으로 내렸다(CY-470).** 24 의 근거는 "300만 전수의 소요를 아직 안 쟀다"
    # 하나였다. 이제 쟀다 — 300만 발급·516만 이력에서 **472초**(7분 52초)이고, 그중
    # replayStep 이 312초다. 6시간은 그 실측의 **45배**다.
    #
    # 하한을 무엇이 정하나 — **BatchStuckExecution 이 먼저 울어야 한다.** 그 알림은
    # batch.stuck-job-after-ms(기본 30분) 동안 진도가 없으면 뜨는데, 이 값이 그보다 작으면
    # **증거(asof_state)가 신고보다 먼저 사라진다.** 6시간은 30분의 12배다.
    #
    # ⚠️ **실제 수거 시점은 이 값이 아니라 정리 크론이 정한다.** 정리는 하루 한 번(04:30)만
    #    도므로, 05:00 에 버려진 실행은 이 값이 6이든 23이든 **다음 날 04:30 에** 같이 걷힌다.
    #    이 값이 실제로 갈라 주는 것은 "다음 정리냐 그다음 정리냐"(24 이상이면 뒤쪽)이고,
    #    그 밖의 차이는 정리를 더 자주 돌리는 배포에서만 드러난다.
    #
    # 1 미만은 기동 때 거절한다.
    abandoned-after-hours: ${CLEANUP_ABANDONED_AFTER_HOURS:6}
    # ⚠️ 이것은 **청크 하나의 데드라인**이지 잡 전체의 상한이 아니다 — 만료의
    #    expire.step-timeout-ms 와 같은 뜻이다. CONTINUABLE 로 돌아올 때마다 새 트랜잭션이
    #    열려 매번 다시 센다. **두 Step 이 이 값을 공유한다** —
    #    chunk-size(asof_state 행)든 metadata-chunk-size(잡 실행)든 키우면 이 값도 같이 키운다.
    #
    # ⚠️ 이 값을 stuck-job-after-ms 위로 올리면 살아 있는 정리가 시체로 신고된다 —
    #    RunningJobProbe 생성자가 그 관계를 기동 때 검사한다.
    #    스프링 트랜잭션 타임아웃이 초 단위라 1000 의 배수여야 한다(999 는 0 초, 즉 즉시 만료).
    # ⚠️ **위로 둘이다.** batch.stuck-job-after-ms 뿐 아니라 **storage.yml URL 의
    #    socketTimeout(DB_SOCKET_TIMEOUT_MS, 기본 660000)보다도 작아야 한다** —
    #    DataSourceTimeoutGuard 가 세 Step 데드라인 중 가장 큰 값과 비교해 기동 때 거절한다.
    #    이 값을 올리면 DB_SOCKET_TIMEOUT_MS 도 함께 올린다. 안 올리면 배치가 안 뜬다.
    step-timeout-ms: ${CLEANUP_STEP_TIMEOUT_MS:120000}

  # admin API 의 트랜잭션 데드라인(초). 조회·중단 요청이 배치 메타를 만지는 시간 상한이다.
  #
  # ⚠️ **트랜잭션 밖이면 끊을 수단이 아예 없다.** DataSourceUtils 가 queryTimeout 을
  #    트랜잭션이 있을 때만 붙인다 — 그래서 이 값이 아니라 **경계 자체**가 먼저 필요했다.
  #    형제 BatchRunMetricsRefresher 의 batch.metrics.run-timeout-ms(5000)와 같은 값이다.
  #
  # ⚠️ POST /api/v1/admin/verify(트리거)에는 안 건다. 그 메서드는 잡을 띄우는데, 감싸면
  #    새 실행의 메타 쓰기가 이 트랜잭션에 들어와 롤백 시 **행이 사라진다.**
  #
  # recover-timeout-seconds 는 조회(5초)보다 길다 — 선점 락이 recover 끝까지 이어지므로
  # 같은 예산으로 두면 정상 복구가 데드라인에 걸린다. 둘을 합치지 마라.
  admin:
    timeout-seconds: ${BATCH_ADMIN_TIMEOUT_SECONDS:5}
    recover-timeout-seconds: ${BATCH_ADMIN_RECOVER_TIMEOUT_SECONDS:10}

    # 관리자 API 토큰 관문(CY-742). 기본 켜짐.
    #
    # /api/v1/admin/** 에는 트리거만 있는 것이 아니라 stop·recover·abandon 이 있다 —
    # 포트에 닿는 누구나 도는 잡을 죽일 수 있다. docs/11 §11 은 그것을 포트 미노출 하나로
    # 막기로 했는데, 관제 화면을 붙이면서 그 전제가 흔들린다.
    #
    # ⚠️ docs/11 §11 과 모순이 아니다. 거기서 거부한 것은 **서명 없는 역할 클레임**이다
    #    (클라이언트가 주장하는 값이라 방어가 아니라 장식). 이쪽은 주장이 아니라 **소지**를
    #    묻는다 — 값을 가진 쪽만 통과한다.
    #
    # ⚠️ 이것으로 충분하지 않다. TLS 가 없으면 평문으로 오가고, 유출되면 회수가 재기동뿐이다.
    #    **포트 미노출이 여전히 1차 방어선**이고 이것은 그 뒤에 서는 2차다.
    #
    # 켠 채 token 이 비면 기동을 거절한다 — "관문 있는 척" 이 제일 나쁘다.
    # 일부러 열어 둘 거라면 required=false 로 명시한다(그때는 포트를 내보내면 안 된다).
    auth:
      required: ${BATCH_ADMIN_AUTH_REQUIRED:true}
      token: ${BATCH_ADMIN_TOKEN:}

    # 업무 포트를 호스트로 내보냈는지. **앱은 스스로 알 수 없어서 배포가 알려 준다**
    # (batch-expose.yml 이 참으로 준다). 알림이 "무방비" 를 판정하는 데 쓴다 —
    # 관문이 꺼진 것만으로는 위험한지 알 수 없고, **포트가 열린 채 꺼진 것**이 위험이다.
    # 이 신호가 없으면 포트를 안 내보내는 평범한 로컬 스택마다 알림이 울려 곧 무시된다.
    port-exposed: ${BATCH_ADMIN_PORT_EXPOSED:false}

    # 관제 화면이 브라우저에서 이 API 를 부를 수 있게 허용할 오리진(CY-742).
    # 쉼표로 나열한다. 기본은 로컬 개발 서버 넷이다.
    #
    # ⚠️ CORS 는 방어가 아니다 — 브라우저만 지키는 규칙이라 curl 에는 효력이 없다.
    #    관리자 API 의 방어선은 둘이다 — 1차는 포트 미노출(docs/11 §11), 2차는 토큰 관문
    #    (AdminTokenFilter). 이 값을 늘려도 닿을 수 있는 사람은 안 늘어난다.
    #
    #    배치를 다른 호스트에 띄우면 관제 오리진을 여기 적는다. * 는 쓰지 않는다 —
    #    방어가 아니라도 전면 허용을 기본값으로 두면 넓어진 것을 아무도 못 본다.
    cors:
      allowed-origins: ${BATCH_ADMIN_CORS_ORIGINS:http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173}

  # JDBC 타임아웃 검사를 강제할지(CY-697). 기본 true.
  #
  # ⚠️ 이 가드가 막으려는 사고를 **가드 자신이 일으킬 수 있다** — 거절하면 배치가 통째로
  #    안 뜨고 @Scheduled 여덟이 다 선다. SchemaPresenceGuard 의 require-batch-indexes 와
  #    같은 이유로 손잡이를 둔다. 끄면 조용히 넘어가지 않고 ERROR 로그로 남는다.
  datasource-timeout-guard:
    required: ${DATASOURCE_TIMEOUT_GUARD_REQUIRED:true}

  # 배치 메타 인덱스가 없을 때 기동을 거절할지(CY-686). 기본 true.
  #
  # ⚠️ 앞 두 축(테이블·컬럼)과 성질이 다르다. 그쪽은 없으면 잡이 SQL 에러로 죽지만
  #    인덱스는 **정확성이 아니라 성능**이다 — 없으면 되읽기가 데드라인을 넘겨 게이지가
  #    NaN 이 되거나 정리 잡이 매 청크 전체 스캔을 할 뿐이다.
  #
  #    그런데 여기서 못 뜨면 같은 프로세스의 CouponRoundScheduler 도 안 돌아 open_at 이
  #    지난 회차가 SCHEDULED 로 남고 **발급 문이 안 열린다** — 만료·정리도 함께 선다.
  #    방어의 대가가 방어 대상보다 크면 안 되므로 끄는 손잡이를 둔다. 끄면 조용히 넘어가지
  #    않고 ERROR 로그로 남는다.
  #
  #    가드는 이름뿐 아니라 **선두 컬럼까지** 대조한다. V2026082513 헤더의 실측이 근거다 —
  #    (JOB_INSTANCE_ID, STATUS, END_TIME) 은 type=index rows=25,950 인데
  #    (STATUS, END_TIME) 은 type=range rows=2,016 이다. 이름만 보면 같은 이름의 다른
  #    모양이 통과한다.
  schema-guard:
    require-batch-indexes: ${SCHEMA_GUARD_REQUIRE_BATCH_INDEXES:true}

  # JVM 기본 존이 UTC 가 아닐 때 기동을 거절할지(CY-718). 기본 true.
  #
  # ⚠️ 배치 메타의 시각(START_TIME · LAST_UPDATED)을 스프링 배치가 **JVM 기본 존**의
  #    LocalDateTime 으로 찍고, Timestamp.valueOf 를 지나며 MySQL 세션 존(UTC)으로
  #    렌더링돼 저장된다. 그래서 **자바 쪽 값이 JVM 기본 존인 채 원시로 바인딩되는 자리**가
  #    컬럼과 다른 축에 선다 — 원시 LocalDateTime 은 그 정규화를 안 타기 때문이다
  #    (TimestampBindingAxisTest 가 서버가 본 값을 단언한다).
  #
  #    ⚠️ RunningJobProbe 는 여기 해당하지 않는다. 쓰기와 읽기가 같은 Timestamp 축을
  #    대칭으로 지나 같은 JVM 안의 왕복은 존과 무관하게 항등이다 — 한때 이 주석이
  #    그것을 근거로 들었는데 실측에서 거짓이었다. 정본은 DefaultZoneGuard 의 javadoc 이다.
  #
  #    실제로 어긋나는 자리는 verification_runs.started_at 이다(같은 행의 as_of 는 UTC).
  #    선점문의 :stuckBefore 도 그랬는데 StuckRunClaim.claim 이 바인딩을 감싸 닫았다.
  #    증상이 "가드가 안 운다" 뿐이라 기동 때 잡는다.
  #
  #    테스트 JVM 은 일부러 Asia/Seoul 이라 테스트 설정이 이 값을 false 로 둔다.
  timezone-guard:
    required: ${TIMEZONE_GUARD_REQUIRED:true}

  metrics:
    # 마지막 성공 시각·멈춘 실행 수를 배치 메타에서 되읽는 주기.
    # 게이지가 스크레이프 경로에서 DB 를 치지 않게 하는 값이다 — 거기서 질의하면 DB 가 느린 날
    # 액추에이터 응답이 늘어져 "지표를 못 읽는 것" 과 "배치가 안 도는 것" 이 같은 모양이 된다.
    # ⚠️ 게이지는 "마지막 되읽기 시점에 알던" 값이라, 이 주기가 ExpireNotSucceeding 의
    #    expire-sla-seconds 예산을 그대로 갉아먹는다. 만료 슬롯 건너뛰기의 최대 지연과
    #    겹치면 정상 상태에서 오탐 critical 이 난다 — 그래서 120000 을 넘으면 기동을 거절한다.
    run-refresh-ms: ${BATCH_RUN_METRICS_REFRESH_MS:60000}
    # 만료 대기 건수를 원본에서 되읽는 주기. 위 run-refresh-ms 와 **다른 키**다 —
    # 그쪽은 배치 메타를 읽고 이쪽은 issuances 를 읽어, 무거워지는 이유가 다르다.
    #
    # 실측(발급 40만 · 대기 800건): COUNT_PENDING 은 idx_issuance_status_expires 의
    # range 스캔이라 **전체 행이 아니라 대기 건수에 비례**해 1ms 다.
    # BLOCKED_COUPONS 는 여기서 안 돈다 — 잡의 태스클릿이 부르고, 되읽기는
    # 그 결과를 배치 메타에서 읽는다.
    # 훑는 범위는 "성공한 실행이 못 걷은 몫" 이지 하루치가 아니다.
    # 한 주기가 내는 문장은 여덟 남짓이고 무거운 쪽은 실행 문맥 blob
    # 역직렬화다 — 근거는 ExpirePendingRefresher 의 비용 절에 적었다.
    #
    # ⚠️ **10000~120000 만 받는다 — 기동 때 거절한다.** 알림의 for 예산이 이 주기의
    #    배수로 잡혀 있다: ExpireLeavesWorkBehind(10분 = 열 주기) ·
    #    ExpireMetricsUnknown(15분 = 열다섯 주기). 상한(120초)에서도 각각 다섯 · 7.5
    #    주기라 스크레이프 흔들림 한 번에 타이머가 안 깨진다. 그보다 늘리면 그 여유가
    #    사라지고, 줄이면 위 실측이 전제한 비용을 넘는다.
    expire-pending-refresh-ms: ${EXPIRE_PENDING_REFRESH_MS:60000}
    # 첫 발화까지 미루는 시간. **운영에서는 0 이고 테스트만 쓴다** —
    # @EnableScheduling 이 모든 테스트 컨텍스트에서 살아 있어, 이 되읽기가
    # 테스트가 손으로 부르는 refresh() 와 같은 빈에서 경합한다. 주기를 늘리는
    # 것은 확률만 줄이므로 실행 시간보다 긴 지연으로 창을 닫는다.
    expire-pending-initial-delay-ms: ${EXPIRE_PENDING_INITIAL_DELAY_MS:0}
    # 그 되읽기의 데드라인. 배치 메타 되읽기와 **별도 키**다 — 읽는 대상이 달라 무거워지는
    # 이유가 다르고, 한 손잡이로 묶으면 한쪽 때문에 다른 쪽을 조인다.
    # 스프링 트랜잭션 타임아웃이 초 단위라 1000 의 배수여야 한다(999 는 0 초, 즉 즉시 만료).
    expire-pending-timeout-ms: ${EXPIRE_PENDING_TIMEOUT_MS:5000}
    # 회차 전이 대기 되읽기 주기. CouponRoundScheduler 는 배치 메타를 안 남기므로
    # "마지막으로 성공한 실행" 축이 없다 — 그래서 실행 여부가 아니라 **결과**를 본다.
    #
    # ⚠️ **상한은 120초다(형제 되읽기 둘과 같다).** 늘려서 나빠지는 것은 for 타이머가
    #    아니다 — 게이지는 스크레이프(15초)마다 캐시된 스냅샷을 내주므로 창이 비지 않는다.
    #    실제 대가는 **값의 나이**(탐지가 그만큼 늦고 해소 뒤에도 알림이 그만큼 서 있다)와,
    #    CouponRoundMetricsStale 이 10분 창에서 시도 횟수를 세므로 주기가 크면 임계 3 을
    #    **구조적으로 못 채우는** 것이다.
    coupon-round-refresh-ms: ${COUPON_ROUND_REFRESH_MS:60000}
    # 첫 발화까지 미루는 시간. **운영에서는 0 이고 테스트만 쓴다** — 이유는
    # expire-pending-initial-delay-ms 와 같다.
    coupon-round-initial-delay-ms: ${COUPON_ROUND_INITIAL_DELAY_MS:0}
    # 그 되읽기의 데드라인. 스프링 트랜잭션 타임아웃이 초 단위라 1000 의 배수여야 한다.
    coupon-round-timeout-ms: ${COUPON_ROUND_TIMEOUT_MS:5000}
    # 배치 메타 되읽기의 데드라인. 스케줄러 스레드에서 도는 조회라 끊을 수단이 없으면
    # 커넥션 풀이 마른 날 다음 주기도 안 돈다. 스프링 트랜잭션 타임아웃이 초 단위라
    # 1000 의 배수여야 한다 — 아니면 기동 때 거절한다.
    run-timeout-ms: ${BATCH_RUN_METRICS_TIMEOUT_MS:5000}
    # ExpireNotSucceeding 이 쓰는 SLA. **알림 식의 값과 같아야 한다** —
    # 프로메테우스는 앱 설정을 못 읽으므로 두 곳이 손으로 맞춰져 있다.
    #
    # 여기 있는 이유는 기동 가드 때문이다. ExpireScheduler 생성자가
    #   (max-expire-skips + 1) × 크론 최대간격 + run-refresh-ms + 잡 소요 상한  <  이 값
    # 을 검사해 안 맞으면 기동을 거절한다. 그 검사가 없으면 크론이나 max-expire-skips 를
    # 조금만 올려도 정상 상태에서 오탐 critical 이 난다.
    #
    # ⚠️ **잡 소요 항이 왜 들어가나(CY-470 리뷰).** 게이지가 내는 값은 END_TIME 이라,
    #    이번 실행이 아직 안 끝났으면 그동안 나이가 계속 자란다. 그 항이 없으면
    #    "어제보다 오래 걸린 정상 실행" 이 도는 도중에 critical 이 뜬다.
    #    소요 상한으로는 BatchJobRunningTooLong 의 임계(600초)를 쓴다 — 그 값이 이미
    #    "이보다 오래 걸리면 사람이 본다" 는 선언이라, 두 알림이 한 축 위에 선다
    #    (warning 이 먼저, 그래도 안 끝나면 critical).
    #
    # 일 1회 · max-expire-skips=0 · 되읽기 60초 · 소요 600초면
    # (0+1) × 86,400 + 60 + 600 = 87,060 초다. 그 위에 여유 2,940초를 둔 값이다 —
    # 만료가 하루를 거르면 25시간째에 운다.
    #
    # ⚠️ **한때 180,000(50시간)이었다.** 건너뛰기를 켜 둔(max-expire-skips=1) 대가였다 —
    #    검증을 뚫고 만료를 돌리면 그 검증의 asOf 를 영구히 못 쓰는데(재시딩 말고 복구가
    #    없다), 만료가 하루 밀리는 것은 다음 슬롯이 밀린 대상을 함께 가져간다. 값이 다른
    #    두 사고라 건너뛰기를 남기고 SLA 를 무디게 뒀다.
    #    CY-470 이 검증을 05:00 크론에 걸어 일정 분리를 세웠고, 겹침 자체가 없어지면서
    #    둘을 함께 되돌렸다 — max-expire-skips 0 · 이 값 90,000.
    expire-sla-seconds: ${EXPIRE_SLA_SECONDS:90000}
    # CleanupNotSucceeding 이 쓰는 SLA. 위와 같이 **알림 식의 값과 같아야 한다.**
    # CleanupScheduler 생성자가 "크론 최대간격 + run-refresh-ms + 잡 소요 상한 < 이 값" 을
    # 기동 때 검사한다 — 그 검사가 없으면 CLEANUP_CRON 을 주 1회로 바꾸는 것만으로 정상
    # 상태에서 매일 warning 이 뜬다.
    # 일 1회(86,400) + 되읽기(60) + CleanupRunningTooLong(900) = 87,360, 여유 2,640초.
    #
    # ⚠️ **이 부등식은 yield 를 모델링하지 않는다.** 정리는 검증이 도는 중이면 횟수 제한 없이
    #    물러나는데(종료 코드 YIELDED), 만료의 max-expire-skips 같은 상한이 없다.
    #    그 상태를 잡는 것이 CleanupNotSucceeding 자신이다 — 물러난 실행은 마지막 성공에
    #    안 실리므로 25시간째에 운다. 상한을 세우는 대신 알림이 지게 한 결정이다.
    cleanup-sla-seconds: ${CLEANUP_SLA_SECONDS:90000}
    # VerifyNotSucceeding 이 쓰는 SLA. 위 둘과 같이 **알림 식의 값과 같아야 한다.**
    # VerifyScheduler 생성자가 "크론 최대간격 + run-refresh-ms + 잡 소요 상한 < 이 값" 을
    # 기동 때 검사한다.
    # 일 1회(86,400) + 되읽기(60) + VerifyRunningTooLong(1,200) = 87,660, 여유 2,340초.
    # 소요 항이 셋 중 가장 큰데, 검증이 실측 472초로 가장 무거운 잡이라서다.
    #
    # ⚠️ **만료와 달리 건너뛰기 항이 없다.** 만료는 (max-expire-skips + 1) 배가 붙는데
    #    검증은 슬롯을 건너뛰지 않는다 — 앞 실행이 아직 돌면 스프링의 크론 트리거가
    #    애초에 다음 발화를 안 잡기 때문이다.
    #
    # ⚠️ **이 SLA 의 그레인은 (dataset=CLEAN, scope=FULL) 이다.** 잡 이름 그레인인
    #    cy_batch_last_success_seconds 를 쓰면 CORRUPT 손 트리거 한 번이 같은 시계열을
    #    앞으로 밀어 SLA 를 리셋한다 — 정작 게이트가 보는 CLEAN/FULL 은 며칠째 안 돌았는데
    #    조용하다. 그래서 cy_verify_last_success_seconds{dataset,scope} 를 따로 낸다.
    verify-sla-seconds: ${VERIFY_SLA_SECONDS:90000}

    # ── 잡 소요 상한 셋 ─────────────────────────────────────────────────────
    # 위 세 SLA 부등식의 마지막 항이다. 게이지가 내는 값은 END_TIME 이라 이번 실행이 아직
    # 안 끝났으면 그동안 나이가 계속 자란다 — 그 항이 없으면 "어제보다 오래 걸린 정상
    # 실행" 이 도는 도중에 critical 이 뜬다. SlaBudget 이 세 스케줄러의 부등식을 진다.
    #
    # ⚠️ **batch-alerts.yml 의 RunningTooLong 임계와 같은 값이어야 한다.** 프로메테우스는 앱
    #    설정을 못 읽으므로 두 곳이 손으로 맞춰져 있다 — 위 SLA 초 값과 같은 규율이다.
    #    같은 값이라야 두 알림이 한 축 위에 서고 warning(RunningTooLong)이
    #    critical(NotSucceeding)보다 **먼저** 뜬다. 어긋나면 순서가 뒤집혀 진단이 거꾸로 간다.
    #
    # ⚠️ **짧은 크론에서는 이 항이 지배적이다.** 시연용 5분 크론이면
    #    300 + 60 + 600 = 960 이라 expire-sla-seconds 를 961 이상으로 줘야 기동이 통과한다.
    #    SLA 를 못 올리는 상황이면 이 값을 내리고 알림 임계도 함께 내린다 —
    #    그것이 이 셋을 상수가 아니라 손잡이로 연 이유다.
    #
    # 1 미만은 기동 때 거절한다. 0 은 그 항을 없애는 것이라 손잡이의 존재 이유가 사라진다.
    expire-running-too-long-seconds: ${EXPIRE_RUNNING_TOO_LONG_SECONDS:600}
    cleanup-running-too-long-seconds: ${CLEANUP_RUNNING_TOO_LONG_SECONDS:900}
    # 셋 중 가장 큰데, 검증이 실측 472초로 가장 무거운 잡이라서다(그 2.5배).
    verify-running-too-long-seconds: ${VERIFY_RUNNING_TOO_LONG_SECONDS:1200}

  # 실행 중으로 남은 잡을 언제부터 "시체" 로 볼 것인가. 만료↔검증 상호 배제가 이 값을 쓴다.
  #
  # 판정 기준은 나이가 아니라 **진도**다 — BATCH_STEP_EXECUTION.LAST_UPDATED 가 청크 커밋마다
  # 다시 찍히므로, 이 값만큼 진도가 멈춰 있으면 종료 표시를 못 남기고 죽은 것으로 본다.
  # 상한이 아예 없으면 docker compose down 이 잡 한복판에 한 번 걸린 것만으로 상호 배제가
  # 영구히 막힌다(그 조회에는 END_TIME 검사도 시간 상한도 없다).
  #
  # ⚠️ 양쪽에서 눌린다. 어느 쪽이든 붙여 놓으면 "살아 있다" 와 "죽었다" 가 같은 숫자를 쓴다.
  #    아래: batch-alerts.yml 의 BatchJobRunningTooLong(600초)·CleanupRunningTooLong(900초)
  #          보다 커야 한다 — 그 알림들이 읽는 지표는 JVM 안의 게이지라, 그것이 우는 상태는
  #          정의상 "살아서 느리게 돌고 있다" 다.
  #    위:   verify·expire·cleanup 의 step-timeout-ms **셋 다**보다 커야 한다. verifyJob 의
  #          Step 열 개는 단발 태스클릿이고, 정리 Step 은 하트비트가 청크 커밋에만 뛴다.
  #          붙여 놓으면 정상적으로 오래 도는 검증이 시체로 판정돼 만료가 검증 한복판을
  #          지나가거나, 살아 있는 정리가 BatchStuckExecution 으로 신고된다.
  #    RunningJobProbe 생성자가 위쪽 관계를 기동 때 검사한다 — 어기면 안 뜬다.
  stuck-job-after-ms: ${BATCH_STUCK_JOB_AFTER_MS:1800000}

  # 스케줄러 스위치. 이 하나로 전 스케줄러가 멈춘다. 끌 것이 여러 개면 하나는 반드시 빠뜨린다.
  #
  # ⚠️ **이것은 검증의 가드가 아니다.** CY-384 전에는 verifyJob 이 이 값을 읽어 true 면
  #    거절했는데, 운영은 늘 true 라 검증이 영영 못 돌았다. 지금 검증을 막는 것은
  #    실제로 도는 만료 실행이다(VerifyJobConfig.rejectRunningExpire).
  #
  # 그래도 결정론 증명(같은 asOf 로 두 번) 앞에서는 여전히 이 값을 끈다. 양방향 가드는
  # 한 실행 "안" 을 지키지, 두 실행 "사이" 에 만료가 지나가는 것은 못 막는다.
  # 그때 2회차는 startRunStep 의 rejectIssuancesUpdatedAfterAsOf 에서 죽어 지문을 아예 못 낸다
  # — 비교할 두 번째 값이 안 생기고, 그 asOf 는 그 뒤로 영구히 못 쓴다.
  #
  # ⚠️ 검증용 DB(coupon_clean · coupon_corrupt)를 보게 띄울 때는 반드시 false 로 준다.
  #    만료 배치는 재고를 쓰는 유일한 잡이라, 켜진 채로 검증 셋을 보면 검증 대상 데이터를
  #    직접 고친다. CORRUPT 셋에서는 일부러 심은 오염까지 건드려 expected 집합과 어긋나고,
  #    그때는 셋을 다시 만드는 것 말고 되돌릴 방법이 없다.
  #
  # 그래서 기본값이 false 다 — **주지 않으면 안 도는 쪽**이다. 두 사고의 무게가 다르기 때문이다.
  #   켜진 채 검증 셋을 보면  → 오염. 셋을 다시 만드는 것 말고 되돌릴 방법이 없다.
  #   꺼진 채 운영을 보면      → 만료가 밀린다. 나중에 돌리면 따라잡고,
  #                             infra/prometheus/rules/batch-alerts.yml 의 ExpireNotSucceeding 이
  #                             CY-359 부터 실제로 평가된다(base.yml 의 prometheus 가 읽는다).
  #                             ⚠️ 그 대가로, 이 값이 false 인 채 띄우면 그 알림이 영구히 뜬다.
  #                             규칙이 틀린 게 아니라 그 설정에서 정상인 상태라, 끄는 구간에만
  #                             사람이 silence 를 건다 — docs/14 4단계에 결정과 명령을 박아 뒀다.
  # 되돌릴 수 있고 감지도 되는 쪽을 기본으로 둔다. 운영은 true 를 명시해서 띄운다.
  scheduling:
    enabled: ${BATCH_SCHEDULING_ENABLED:false}

  schedule:
    # ⚠️ 크론을 어느 좌표계로 푸는가. @Scheduled 는 이 값을 안 주면 JVM 기본 타임존을 쓰는데,
    #    asOf 를 만드는 CronSlot 은 TimeProvider(Clock.systemUTC) 의 값으로 푼다.
    #    둘이 갈리면 asOf 가 발화 시각보다 그 오프셋만큼 과거가 되고, asOf <= now 는 계속
    #    성립하므로 EXPIRE_ASOF_IN_FUTURE 가드도 안 울린다 — 조용히 그만큼 밀린다.
    #    5분 크론이던 시절에는 우연히 안 드러났다(오프셋이 15분 배수라 슬롯에 그대로 떨어진다).
    #    시(hour) 필드가 들어가는 순간 깨지는데, **지금 크론 셋이 전부 그 모양이다** —
    #    expire-cron 04:10 · cleanup-cron 04:30 · verify-cron 05:00. 즉 이 zone 값은
    #    "만약을 위한 것" 이 아니라 지금 실제로 판정을 지고 있다.
    zone: "UTC"
    # 만료는 **배치 창**이다. 5분 크론이었던 것을 04:10 일 1회로 옮겼다(CY-397).
    #
    # 근거는 실측이다 — valid_days 30~180(평균 105)에 ISSUED 약 66만이면 하루 만료가
    # 약 6,300건이고, 5분 실행 한 번이 손대는 것은 **약 22건**(청크 1000의 2%)이었다.
    # 이벤트 진행 중 만료는 0건이다(열린 회차의 쿠폰은 방금 발급돼 기한이 남았다).
    # 실무의 만료·정리·검증은 셋 다 배치 창이지 준실시간이 아니다 — docs/13 §6.
    #
    # ⚠️ **위 zone 이 UTC 라 04:10 은 한국 시각 13:10 이다.** "새벽 배치 창" 은 UTC 기준의
    #    말이고, 시연·리허설이 실제로 일어나는 시간대와 겹친다 — 손 트리거 검증을 그 시각에
    #    걸면 안 되는 이유가 이것이다(아래 max-expire-skips).
    expire-cron: "${EXPIRE_CRON:0 10 4 * * *}"      # 만료 04:10 UTC (= 13:10 KST)
    # 정리는 만료 뒤 20분에 둔다. **순서 때문이 아니라 자원 분리 때문이다** — 정리는 검증이
    # 남긴 파생 행만 걷고 만료가 만드는 것(issuances · coupon_stocks)을 하나도 안 읽는다.
    # 20분이면 만료가 밀려도 겹치지 않는다(BatchJobRunningTooLong 이 600초에서 운다).
    #
    # ⚠️ **실질 상한은 검증 크론(05:00)까지의 1,800초다(CY-470 리뷰).** 정리 Step 은 청크마다
    #    "지금 검증이 도는가" 를 묻고, 돌면 종료 코드 YIELDED 로 물러난다 — 그리고 마지막 성공
    #    시각 조회가 그 코드를 성공에서 뺀다. 즉 05:00 이후의 청크는 **다음 날로 밀린다.**
    #    걷을 양도 CY-470 으로 늘었다 — 검증이 매일 도니 asof_state 가 하루 300만 행씩 쌓이고,
    #    asof-state-keep-runs=5 라 매 밤 한 실행분을 걷어야 한다(chunk-size 10000 이면 300청크).
    #    **아직 안 쟀다.** 보존 창(metadata-keep-days 30)을 처음 넘긴 밤에 둘째 Step 이 몰리는데
    #    (CleanupRunningTooLong 주석), 그 밤에 1,800초를 넘기면 YIELDED 가 이틀 이어져
    #    CleanupNotSucceeding 이 뜬다 — 그 runbook 은 "정리가 안 돌았다" 로 사람을 보내지만
    #    실제 상태는 "매일 돌지만 30분 안에 못 끝낸다" 다. 재고 나서 크론을 앞당기거나
    #    검증을 미룬다.
    cleanup-cron: "${CLEANUP_CRON:0 30 4 * * *}"    # 정리 04:30 (검증까지 1,800초)
    # 검증은 정리 뒤 30분에 둔다. **순서가 아니라 상호 배제 때문이다** — ExpireScheduler 는
    # 검증이 도는 동안 만료 슬롯을 건너뛰고, 그 건너뛰기가 만료 SLA 예산을 먹는다.
    # 시간으로 갈라 두면 건너뛸 일이 없어 아래 max-expire-skips 를 0 으로 내릴 수 있고,
    # 그래야 만료 SLA 가 50시간에서 25시간으로 조여진다(CY-470 이 함께 한 일).
    #
    # 50분 간격의 근거: 만료가 04:10 에 시작해 05:00 전에 끝나야 하는데,
    # BatchJobRunningTooLong 이 만료를 600초에서 잡으므로 정상 상태의 상한이 10분이다.
    # 검증 자신은 300만 행에서 **472초**다(CY-470 실측) — 05:08 에 끝난다.
    #
    # ⚠️ **이 슬롯에 발급 트래픽이 있으면 검증은 매일 실패한다.** startRunStep 의
    #    rejectIssuancesUpdatedAfterAsOf 가 asOf 이후 갱신된 발급건을 보면 실행을 죽인다 —
    #    정합성 검증은 쓰기가 멈춘 스냅샷 위에서만 뜻이 있고, 만료가 찍은 updated_at 은
    #    지워지지 않으므로 **그 asOf 는 영구히 못 쓴다**. 버그가 아니라 전제가 깨졌다는
    #    보고이고, VerifyNotSucceeding 이 그 사실을 진다.
    #    옮겨야 한다면 만료·정리와 겹치지 않는 자리여야 한다 — 겹치면
    #    max-expire-skips=0 이 검증을 뚫고 지나간다.
    verify-cron: "${VERIFY_CRON:0 0 5 * * *}"       # 검증 05:00 UTC (= 14:00 KST)

    # 검증이 도는 동안 만료 슬롯을 몇 번까지 연속으로 건너뛸 것인가.
    # 최대 지연이 (이 값 + 1) × 크론 최대간격으로 **구조적으로** 묶인다.
    #
    # ⚠️ **0 이 된 것은 CY-470 이 검증 크론(05:00)을 세웠기 때문이다.** 그전에는 1 이었다 —
    #    검증을 띄우는 유일한 경로가 사람이 아무 때나 누르는 POST /api/v1/admin/verify 라
    #    시각을 못 가렸고(docs/15), 04:10 UTC 는 **13:10 KST** 라 시연·리허설 시간대였다.
    #    막는 것이 없는데 배제를 끄면, 뚫린 그 검증의 asOf 는
    #    rejectIssuancesUpdatedAfterAsOf 때문에 **영구히 못 쓴다**(재시딩 말고 복구가 없다).
    #    이제 만료 04:10 · 정리 04:30 · 검증 05:00 으로 갈려 겹침 자체가 없다.
    #
    # ⚠️ **온디맨드 API 는 그대로 살아 있다.** 손으로 그 시각에 트리거하면 여전히 겹치고,
    #    이 값이 0 이라 만료가 **뚫고 지나간다** — 그 검증은 버린다. 손 트리거는 배치 창을
    #    피해서 부르는 것이 규약이다.
    #
    # ⚠️ **0 은 "건너뛰기를 끈다" 다.** consecutiveSkips >= maxSkips 를 먼저 보므로 첫 충돌에서
    #    바로 뚫고 지나간다 — 건너뛴 적이 없으므로 ExpireScheduler 가 그 경우만 다른 문구로
    #    ERROR 를 남긴다. ExpireSchedulerVerifyGuardTest 가 0 과 2 를 함께 잰다.
    #
    # ⚠️ **이 값과 크론 주기가 SLA 예산을 먹는다.** 다음이 성립해야 하고,
    #    ExpireScheduler 생성자가 기동 때 검사해 안 맞으면 거절한다:
    #      (이 값 + 1) × 크론 최대간격 + run-refresh-ms + 소요 상한  <  expire-sla-seconds
    #    기본값(0 · 일 1회 · 60초 · 소요 600초)이면 87,060 < 90,000 이라 여유 2,940초다.
    #    그전(1 · 일 1회 · 60초)에는 소요 항이 없어 172,860 < 180,000 이었다.
    max-expire-skips: ${MAX_EXPIRE_SKIPS:0}
    # ⚠️ **읽는 코드가 아직 없다.** 증분 검증에는 스케줄러가 없고 온디맨드 경로도 아직
    #    rejectUnsupportedScope 가 거절한다 — 이 값은 자리 표시이고 크론 문법만 테스트가
    #    확인한다. CY-470 이 세운 것은 위 verify-cron(FULL)이지 이쪽이 아니다.
    verify-incremental-cron: "0 */10 * * * *"  # 증분 검증 10분 (미배선)

    # 회차 상태 전이. CouponRoundScheduler 가 읽는다 — Spring Batch 잡이 아니라
    # @Scheduled 다(1분 주기로 배치 메타를 쓰면 하루 1,440 인스턴스가 된다).
    #
    # ⚠️ **주기를 늘리면 CouponRoundsNotOpening(for 5m)이 오탐한다.** 회차가 열리는 것이
    #    최대 이 간격만큼 늦는데, 그 알림은 "열려야 하는데 안 열렸다" 를 5분 창으로 본다.
    #    5분보다 성기게 하려면 알림의 for 도 함께 늘려야 한다.
    #
    # ⚠️ **재고 소진 마감은 이 크론과 무관하다.** 그건 api 의 발급 경로가 그 자리에서
    #    한다 — 스케줄러를 기다리면 재고가 0인데 OPEN 인 구간이 생긴다.
    coupon-open-cron: "${COUPON_OPEN_CRON:0 * * * * *}"   # 회차 상태 전이 1분
    # 전이 한 건(조회 하나 또는 UPDATE 하나)의 데드라인.
    #
    # ⚠️ **되읽기의 데드라인과 별도 키다.** 이쪽은 발급 경로와 같은 행을 다투는 **쓰기**고
    #    그쪽은 읽기라, 무거워지는 이유가 다르다 — 한 손잡이로 묶으면 한쪽 때문에 다른 쪽을
    #    조인다. 이 값이 없으면 트랜잭션 밖이라 queryTimeout 이 안 붙고, 발급이 그 회차 행을
    #    쥐고 있으면 innodb_lock_wait_timeout(기본 50초)까지 스케줄러 스레드 하나와 커넥션
    #    하나를 물고 있는다.
    # 스프링 트랜잭션 타임아웃이 초 단위라 1000 의 배수여야 한다 — 아니면 기동 때 거절한다.
    coupon-round-tx-timeout-ms: ${COUPON_ROUND_TX_TIMEOUT_MS:5000}

  # 재고를 쓰는 유일한 잡이다. 청크 하나가 한 트랜잭션이고, 죽으면 그 경계에서 이어 간다.
  expire:
    # 한 청크가 넘기는 건수. 트랜잭션 크기이자 재시작 단위다.
    # 크게 잡으면 죽었을 때 되돌리는 양이 늘고, 작게 잡으면 왕복이 늘어난다.
    chunk-size: ${EXPIRE_CHUNK_SIZE:1000}

    # 폭주한 문장을 끊는 유일한 수단이다.
    #
    # innodb_lock_wait_timeout 은 **기다리는 쪽**에 걸리는 값이라, 잠그고 있는 이 잡에는
    # 아무 상한도 되지 않는다. JobOperator.stop() 은 청크 경계에서만 반응해 단일 문장을 못 끊는다.
    # 재고를 쓰고 issuances 를 잠그는 유일한 잡이라 verify 보다 이쪽이 더 급하다.
    #
    # ⚠️ 이것은 **청크 하나의 데드라인**이지 잡 전체의 상한이 아니다. CONTINUABLE 로 돌아올 때마다
    #    새 트랜잭션이 열려 매번 다시 센다 — chunk-size 를 키우면 이 값도 같이 키워야 하고,
    #    잡 전체는 (청크 수 × 이 값) 만큼 돌 수 있다. 실행 전체를 끊는 수단은 아직 없다.
    # ⚠️ **위로 둘이다.** batch.stuck-job-after-ms 뿐 아니라 **storage.yml URL 의
    #    socketTimeout(DB_SOCKET_TIMEOUT_MS, 기본 660000)보다도 작아야 한다** —
    #    DataSourceTimeoutGuard 가 세 Step 데드라인 중 가장 큰 값과 비교해 기동 때 거절한다.
    #    이 값을 올리면 DB_SOCKET_TIMEOUT_MS 도 함께 올린다. 안 올리면 배치가 안 뜬다.
    step-timeout-ms: ${EXPIRE_STEP_TIMEOUT_MS:120000}

  verify:
    # asof_state 는 run 당 300만 행이다. 방치하면 가장 빨리 커지는 테이블이다.
    #
    # CY-397 의 정리 Step 이 이 값을 읽는다 — 최신 이만큼의 실행만 남기고 나머지의
    #    파생 행(asof_state · 통계 셋 · verification_findings)을 걷는다.
    # 키 경로가 살아 있는지만 ResolvedBatchConfigTest 가 확인한다.
    asof-state-keep-runs: ${ASOF_STATE_KEEP_RUNS:5}

    # 한 트랜잭션에 쓰는 발급건 수. 이만큼이 메모리에 올라가고 실패하면 이만큼 되돌린다.
    chunk-size: ${VERIFY_CHUNK_SIZE:1000}

    # 규칙 하나가 낼 수 있는 검출 상한. 여기 닿으면 잡을 멈춘다.
    #
    # 이것은 폭주 방어지 고장 감지 임계값이 아니다. 오염셋 기대는 규칙당 최대 200건
    # (V1 200·V2 200·V3 100·V4 200·V5 100·V6 0, 합계 800)이고, 이 상한은 그보다 50배 크다 —
    # 검출이 300만 발급건만큼 쏟아지는 것을 막는 자리다. 200 을 기준으로 조이면
    # 정상셋·운영 데이터의 기대치가 달라 거짓 중단이 난다.
    max-findings-per-rule: ${VERIFY_MAX_FINDINGS_PER_RULE:10000}

    # Step 트랜잭션의 데드라인. 없으면 폭주한 문장이 커넥션을 물고 늘어져
    # 배치 풀(아래 maximum-pool-size)과 공유 MySQL 이 함께 막힌다.
    # JobOperator.stop() 은 청크 경계에서만 반응해서 단일 문장에는 안 걸린다.
    #
    # 문장 단위가 아니라 트랜잭션 단위다. 청크 Step 에서는 청크 하나의 데드라인이므로
    # chunk-size 를 키우면 이 값도 같이 키워야 한다.
    # MySQL 힌트(MAX_EXECUTION_TIME)를 안 쓰는 이유는 그것이 read-only SELECT 에만 먹어서
    # 이 잡에서 가장 무거운 문장(asof_state 300만 행 UPDATE)을 못 덮기 때문이다.
    # ⚠️ batch.stuck-job-after-ms 보다 **반드시 작아야 한다.** 이 값을 키울 때는 그 값도
    #    함께 키운다 — 안 그러면 살아 있는 검증이 시체로 판정된다. 기동 때 검사한다.
    # ⚠️ **위로 둘이다.** batch.stuck-job-after-ms 뿐 아니라 **storage.yml URL 의
    #    socketTimeout(DB_SOCKET_TIMEOUT_MS, 기본 660000)보다도 작아야 한다** —
    #    DataSourceTimeoutGuard 가 세 Step 데드라인 중 가장 큰 값과 비교해 기동 때 거절한다.
    #    이 값을 올리면 DB_SOCKET_TIMEOUT_MS 도 함께 올린다. 안 올리면 배치가 안 뜬다.
    step-timeout-ms: ${VERIFY_STEP_TIMEOUT_MS:600000}

    # 이력을 한 번에 읽어 올 발급건 식별자 폭.
    # 이력 식별자가 아니라 발급건 식별자로 잘라야 한 발급건의 이력이 두 창에 걸치지 않는다.
    # 크게 잡을수록 왕복은 줄지만 한 번에 올라오는 이력 행이 는다 — 발급건당 평균 1.8행이다.
    replay-window-size: ${VERIFY_REPLAY_WINDOW_SIZE:50000}

    # 요일·시각 집계 한 문장이 훑을 **이력** 식별자 폭. 바로 위 replay-window-size 와 이름이
    # 닮았지만 **축이 다르다** — 그쪽은 발급건 식별자 창이고 막는 것은 JVM 힙(창 하나가 통째로
    # 힙에 올라온다), 이쪽은 이력 식별자 창이고 막는 것은 **MySQL 서버의 RAM** 이다.
    # 자바로는 (요일, 시각) 부분합 최대 168행만 돌아오므로 힙과는 무관하다.
    # 한 손잡이로 묶으면 힙을 넓히려고 올린 값이 DB 서버를 죽인다.
    #
    # ⚠️ **10000 이상 500000 이하다.** 기본값이 곧 상한이라 내리는 쪽으로만 좁힐 수 있고,
    #    그마저도 1만이 바닥이다. 둘 다 기동 때 거절한다.
    #
    #    위쪽: 올릴 수 있게 두면 이 손잡이가 막으려던 사고가 그대로 돌아오는데, 그 사고는
    #    애플리케이션이 아니라 **DB 서버가 죽는** 모양이라 여기서 막지 않으면 막을 자리가 없다.
    #
    #    아래쪽: 0 이하는 창이 전진하지 않아 잡이 아예 안 끝나고, 1~9999 는 왕복이
    #    이력 수 ÷ 이 값만큼 늘어 statsAggregateStep 이 verify.step-timeout-ms 에 걸린다 —
    #    1 이면 516만 셋에서 왕복이 500만 회를 넘는다. **그때 나는 알림은
    #    VerifyNotSucceeding 이고 그 runbook 은 "그 슬롯에 발급이 있었다" 로 사람을 보낸다** —
    #    원인과 처방이 완전히 다른 곳이라, 그 조합을 기동에서 끊는다.
    #    1만이면 같은 셋에서 왕복이 534회다.
    #
    # 근거는 CY-470 실측이다. 516만 이력(그중 event_type='ISSUE' 258만)을 한 문장으로 묶으니
    # mysqld 상주가 902MiB → 1,077MiB 로 뛰었고, 같은 서버에서 강제 종료가 관측된 지점이
    # 1,163MiB 였다 — 여유가 86MiB 뿐이라 안전하다고 부를 수 없다. 50만 폭이면 그 증가분의
    # 1/10 남짓이라 열 배 여유가 남는다. 더 작은 서버라면 내린다.
    history-scan-window: ${VERIFY_HISTORY_SCAN_WINDOW:500000}

    # 판정을 되읽는 주기.
    #
    # 판정을 잡이 밀어 넣지 않고 verification_runs 에서 되읽는다. 검증은 **사람이 손으로
    # 드물게** 돌리므로, 프로세스 게이지로 두면 재배포하는 순간 판정이 지표에서 사라지는데
    # DB 에는 남아 관제와 진실이 갈린다. 되읽으면 재시작해도 한 주기면 복구된다.
    #
    # 만료 지표도 CY-421 이 같은 이유로 되읽기가 됐다 — 위 expire-pending-refresh-ms.
    # (한때 "만료는 5분 크론이라 프로세스 게이지도 곧 복구된다" 를 근거로 뒀는데,
    #  배치 창으로 옮기면서 그 근거가 깨졌다.)
    metrics-refresh-ms: ${VERIFY_METRICS_REFRESH_MS:60000}

    # 그 되읽기의 데드라인.
    #
    # 스케줄러 스레드에서 트랜잭션 밖으로 돌면 queryTimeout 이 안 붙어 끊을 수단이 없다.
    # 1000 이상이면서 1000 의 배수여야 한다 — 스프링의 트랜잭션 타임아웃이 초 단위라
    # 나머지가 조용히 버려진다. 아니면 기동에서 거부한다.
    metrics-timeout-ms: ${VERIFY_METRICS_TIMEOUT_MS:5000}

logging:
  level:
    com.kafkick: DEBUG
  pattern:
    # runId 를 MDC 에 심어 한 run 의 모든 Step 로그를 같은 키로 묶는다.
    console: "%d{HH:mm:ss.SSS} %-5level [%X{runId:-}] %logger{36} - %msg%n"

---
#
# ⚠️ storage.yml 을 덮어쓰는 값만 여기 둔다. storage.yml 과 무관한 키를 여기 두면
#   위 문서의 충돌 검사를 받지 않아, 나중에 storage.yml 에 같은 키가 생겨도 아무도 모른다.
#
# CY-179(관측 전용 DataSource)가 머지되면 관측 풀 이름은 이렇게 가른다 —
#   storage.yml 이 observation.datasource.hikari.pool-name 을 정의하면  -> 여기(덮어쓰기)
#   정의하지 않으면                                                    -> 첫 문서(새 키)
# 인수인계 문서는 storage.yml 이 정의한다고 했지만 아직 어느 브랜치에도 없다.
# 주석을 믿지 말고 BatchConfigPrecedenceTest 가 어느 쪽이라고 하는지를 믿어라.
# 그 키가 생기기 전까지 OBS_POOL_NAME 은 아무 데서도 읽히지 않는다. 지금 줘도 효과가 없다.
#
spring:
  # 마이그레이션 소유자는 api 하나로 고정한다. batch 는 이미 만들어진 스키마 위에서 돈다.
  #
  # 검증 배치가 DDL 권한을 쥐면 "계층 2 는 원본 테이블에 쓰지 않는다" 가 스키마 수준에서 깨진다.
  #
  # 대가는 배포 순서 의존이다. 그런데 **기동은 조용히 성공한다** — batch 에는 @Entity 가 없어
  # ddl-auto: validate 가 공허하게 통과하고, 메타 테이블 존재도 기동 때는 아무도 안 본다.
  # api 보다 먼저 뜨면 기동은 그냥 성공한다 — actuator 가 없어 확인할 헬스 엔드포인트조차 없다.
  # 실패는 잡 실행 시점의 "테이블 없음" SQL 에러로 늦게 드러난다.
  # CY-359 가 그 가드를 만들었다 — SchemaPresenceGuard(ApplicationRunner).
  # 핵심 테이블 여덟(데이터 넷 + Spring Batch 메타 넷)이 없으면 기동을 죽인다.
  # compose 의 depends_on: service_healthy 로는 못 막는다 — 그것은 mysqld 가 살아 있다
  # 까지만 보장하고, base.yml 에는 마이그레이션을 돌릴 api 도 없다.
  #
  # ⚠️ 메타 셋은 데이터 넷과 **따로 빈다.** 검증용 셋(coupon_clean·coupon_corrupt)은
  #    cy-seed 의 ddl/ 로 만들어지는데 거기에 BATCH_* 가 하나도 없다. 그 DB 를 보게
  #    띄우려면 배치 메타 마이그레이션 셋(V11__batch_metadata.sql ·
#    V2026082513__ix_batch_job_execution_lookup.sql · V2026082514__ix_batch_job_execution_history.sql)을
#    따로 부어야 한다 — 절차는 docs/14.
#    ⚠️ 인덱스 둘은 기동 가드가 못 보므로 빠뜨려도 기동과 동작이 통과한다.
  flyway:
    enabled: false

  datasource:
    hikari:
      # 런타임과 풀을 나눈다. HikariCP 사용률이 v1 병목의 증거인데 배치가 나눠 쓰면 증거가 흐려진다.
      # 최악 동시 소비자는 **열하나**다 — 검증 스텝 tx 1 + 검증 JobRepository 1 +
      # 만료 스텝 tx 1 + 만료 JobRepository 1 + **정리 스텝 tx 1 + 정리 JobRepository 1** +
      # 되읽기 **4**(판정 · 배치 실행 · 만료 대기 · 회차 전이 대기) + **회차 전이 문장 1**.
      # 크론은 04:10 · 04:30 · 05:00 으로 갈라 뒀지만 만료가 밀리면 정리·검증과 겹칠 수
      # 있어 최악을 기준으로 잡는다. 회차 전이는 1분마다 도니 그 겹침에 **확실히** 들어온다.
      #
      # ⚠️ **CY-470 이 검증 크론을 세웠어도 이 수는 안 움직인다.** 검증 소비자 둘은 크론이
      #    없던 시절에도 이미 세어져 있었다 — 온디맨드 API(VerifyTriggerController)가
      #    시각을 안 가려서다. 그 API 는 batch.scheduling.enabled 를 안 보므로 크론을 꺼도
      #    남아 있고, 따라서 최악 동시 소비자는 크론 유무와 무관하다.
      #
      # 4 면 그 경로에서 커넥션이 마르고, 11 이면 여유가 0 이다. 하나만 더 붙어도
      # (Hikari keepalive 재수립, 기동 가드, actuator health 의 DB 체크) connection-timeout
      # (3초)에 걸리는데, 그렇게 걸리는 쪽이 하필 되읽기다 — 게이지가 통째로 NaN 이 되고
      # 배치는 멀쩡한데 "만료가 SLA 안에 성공하지 못했습니다" critical 이 나간다.
      # 그래서 여유 둘을 둬 13 이다. api 10 + batch 13 = 23 으로, storage.yml 주석이 적은
      # max_connections=50 안이다(그 값은 주석일 뿐 강제되지 않는다 — 합계를 검사하는 곳이 없다).
      #
      # (CY-421 이 되읽기 하나를 더하며 9 + 여유 2 = 11 로 세웠고, CY-446 이 소비자 둘을
      #  더해 11 + 여유 2 = 13 이 됐다. 여유 둘은 **우리가 안 세는 소비자** 몫이라 유지한다.)
      #
      # 이 변경 전에는 storage.yml 이 이겨서 batch 풀도 DB_POOL_SIZE 가 움직였다.
      # 이제 손잡이는 BATCH_DB_POOL_SIZE 다 — DB_POOL_SIZE 만 주던 배포도 10 그대로다.
      maximum-pool-size: ${BATCH_DB_POOL_SIZE:13}
