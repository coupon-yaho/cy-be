# 회차 파라미터. cp perf/env/perf.env.example perf/env/perf.env 후 값을 채운다.
# perf.env 는 커밋하지 않는다(perf/.gitignore).

# ── 토폴로지 ────────────────────────────────────────────────────────────────
# A = 발급 경로 전부(MySQL·Redis·Prometheus·api×4·nginx). B = k6. C = 프론트.
# B 에서 돌릴 때 A_HOST 는 A 의 유선 IP 다. 맥북 단독 검증이면 127.0.0.1.
A_HOST=127.0.0.1
PERF_LB_PORT=8080
COMPOSE_PROJECT=couponperf

# A 의 도커를 B 에서 조작하려면 채운다. 비우면 이 스크립트가 A 에서 도는 것으로 본다.
# 예: PERF_A_SSH=seol@192.168.0.20
PERF_A_SSH=
PERF_A_REPO=

# ── api 수용 한계 ───────────────────────────────────────────────────────────
# 기본 4000+1000=5,000 상한을 안 풀면 VU 2만의 상당수가 응답이 아니라
# duration 0s(연결 실패)로 찍힌다. 실측으로 밟은 자리다.
PERF_API_REPLICAS=4
PERF_TOMCAT_MAX_CONNECTIONS=20000
PERF_TOMCAT_ACCEPT_COUNT=20000
PERF_TOMCAT_THREADS_MAX=15
PERF_DB_POOL_SIZE=3
PERF_MYSQL_MAX_CONNECTIONS=50

# ⚠️ 힙을 명시하지 않으면 컨테이너 메모리의 25% 다. 3g 제한 → 힙 768MB → OOMKilled.
PERF_API_MEM=3g
PERF_API_HEAP=1g
PERF_BATCH_HEAP=512m
PERF_BATCH_SCHEDULING_ENABLED=false

# ── 시드 ────────────────────────────────────────────────────────────────────
# 1인 1매가 회차 단위다. 요청 N 이면 서로 다른 회원 N 명이 필요하다.
PERF_MEMBERS=200000
PERF_DUMMY_ISSUANCES=300000
PERF_TEMPLATE_ID=9001
PERF_BRAND_ID=9001

# ── 회차 프로필 ─────────────────────────────────────────────────────────────
# ENGINE 은 회차의 issuance_engine_version 이다. v1/v2 는 이것만 다르다.
PERF_ENGINE=V2
PERF_ROUND_STOCK=10000
# spike | steps
PERF_PROFILE=spike
# 같은 조건 반복 횟수. 중앙값으로 비교한다
PERF_REPEATS=5

# 워밍업 — 버퍼풀·JIT. 실측: 300/s x 25s 를 앞에 두니 med 24ms→4ms, p95 861ms→12ms.
PERF_WARMUP_RATE=300
PERF_WARMUP_SECONDS=25
# 워밍업 회차는 매진되면 안 된다
PERF_WARMUP_STOCK=1000000

# spike 프로필
PERF_SPIKE_REQUESTS=20000
PERF_SPIKE_SECONDS=3

# steps 프로필 — 단계마다 새 회차를 쓴다(한 회차로 올리면 첫 단계에서 재고가 끝난다)
PERF_STEP_RATES=200,400,600,800,1000
PERF_STEP_SECONDS=20

# k6 클라이언트 타임아웃. 서버 요청 예산보다 커야 한다 — 역전되면 "기다리게 한다"가
# "엉뚱한 데서 끊긴다"가 된다(docs/12 §10.4 의 타임아웃 계층).
PERF_HTTP_TIMEOUT=60s

# ── 이미지 ──────────────────────────────────────────────────────────────────
# ⚠️ ./gradlew bootRun 으로 재지 않는다. bootRun 은 -XX:TieredStopAtLevel=1 로 떠서
#    C2 JIT 이 꺼져 있다. 같은 구간에서 305/s vs 400/s — 약 30% 낮게 나왔다(실측).
#    컨테이너나 jar 로만 잰다. 태그는 커밋 SHA 로 박아 회차 간 비교를 가능하게 한다.
PERF_IMAGE_REPO=coupon-yaho-perf
PERF_SKIP_BUILD=
